<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Audio">
    <PackageVersion Include="NAudio" Version="2.2.1" />

    <!-- Cover art for Ogg/Opus only (plan §5.2). ffmpeg writes every textual tag and every
         other container's picture; TagLib# is the documented fallback for the one case
         ffmpeg's METADATA_BLOCK_PICTURE support does not handle reliably. -->
    <PackageVersion Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup Label="Hosting, config and logging">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup Label="Settings">
    <!-- DPAPI (ProtectedData) is not in the box on modern .NET; it ships as this package.
         Used to protect the Spotify refresh token before it reaches settings.json (plan §6). -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Interop and IO">
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.298" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.2.0" />
  </ItemGroup>

  <ItemGroup Label="Spotify Web API">
    <!-- SpotifyAPI.Web.Auth is deliberately not referenced: it still depends on EmbedIO 3.5.2
         even at this version (verified against its nuspec), and dropping EmbedIO is the point
         (plan §8, §10 Phase 4). The PKCE loopback listener is hand-rolled on HttpListener
         instead — see Spotify/Auth/SpotifyLoopbackListener.cs. -->
    <PackageVersion Include="SpotifyAPI.Web" Version="7.4.2" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.2.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

</Project>
