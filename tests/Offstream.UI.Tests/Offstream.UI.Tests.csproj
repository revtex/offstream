<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ViewModel, controller and service tests for the shell. Nothing here drives a window: the
    end-to-end FlaUI suite that used to live alongside them is gone, and the window itself is
    verified by hand.
  -->
  <PropertyGroup>
    <RootNamespace>Offstream.UI.Tests</RootNamespace>
    <AssemblyName>Offstream.UI.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Offstream.App\Offstream.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />

    <!-- A fake session factory needs a track source and an encoder, and SettingsStore needs
         somewhere to not find a settings file. -->
    <PackageReference Include="Moq" />
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" />
  </ItemGroup>

</Project>
