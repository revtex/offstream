<UserControl x:Class="Offstream.App.Views.Pages.MetadataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Offstream.App.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Offstream.App.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!--
            The "was …" line under a field, shown only where the proposal differs from the file.

            A before-and-after on every field is three extra lines that say nothing three times
            out of four, and it buries the one line that does.
        -->
        <Style x:Key="MetadataWasStyle" BasedOn="{StaticResource OffstreamHintStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <!--  A label above its field, spaced from the field under it — the shape every other page uses.  -->
        <Style x:Key="MetadataFieldStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!--  A value the match supplied and the user cannot type over, on its own line.  -->
        <Style x:Key="MetadataValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--
            One scanned file, as it appears in the list.

            An ItemsControl row template rather than a DataGrid: nothing else in this application
            uses a DataGrid, WPF-UI does not theme one, and a grid dropped in here would carry its
            own chrome, its own selection model and its own idea of a header into a shell built
            out of cards.

            The row shows *what will be written* — title, then artist and album, then the file it
            came from — and nothing else. It used to open an editor underneath itself, and the
            editor never fitted: measured, an opened row was 539 device-independent pixels inside
            a viewport of 347, so picking a track hid the library it was picked from and pushed
            the search results off the bottom edge. The editor is now a pane of its own to the
            right, and picking a row moves nothing.

            Every text column trims rather than wraps, and the list below disables horizontal
            scrolling. That combination is load-bearing: a ScrollViewer that permits horizontal
            scrolling measures its content at infinite width, so a star-sized column takes the
            full unwrapped width of the longest file name in the folder and drags every other
            column off the right-hand edge. One long name used to reshape the whole page.
        -->
        <DataTemplate x:Key="LibraryTrackTemplate" DataType="{x:Type vm:LibraryTrackViewModel}">
            <!--
                The right-hand padding is for the scroll bar. WPF-UI draws it as an overlay: it
                is painted over the viewport rather than taking width from it, so the rows are
                measured as though it were not there and it lands on top of the last column of
                every row it covers. Nothing in the layout can discover that, so the room is
                reserved.
            -->
            <Border Padding="8,10,20,10"
                    BorderBrush="{StaticResource OffstreamRowSeparatorBrush}"
                    BorderThickness="0,0,0,1"
                    ToolTip="{Binding Path, Mode=OneTime}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Margin="0,0,4,0"
                              VerticalAlignment="Center"
                              AutomationProperties.HelpText="{x:Static res:Strings.MetadataSaveHelp}"
                              AutomationProperties.Name="{Binding FileName, Mode=OneTime}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                    <Border Grid.Column="1"
                            Width="40"
                            Height="40"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4">
                        <Image Source="{Binding SuggestedCoverArtSource, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding Title, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />

                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Summary, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />

                        <TextBlock Style="{StaticResource OffstreamHintStyle}"
                                   Text="{Binding FileName, Mode=OneTime}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />

                        <!--
                            The reason a row failed, wrapped rather than trimmed. It is the one
                            piece of text on the page the user can act on — a locked file, an
                            expired sign-in, a throttle that has not cleared — and half of it is
                            no use at all. It sits in the list rather than in the editor because
                            a failure the user has to go looking for is one they will not find.
                        -->
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Text="{Binding FailureReason, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasFailed, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>

                    <!--
                        Which rows Save would touch, and where each one got to. Stacked rather
                        than set side by side: the list column is now half the page, and two
                        columns of status text left the title with nothing.
                    -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding StatusText, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />

                        <Border Margin="0,4,0,0"
                                Padding="7,2"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{StaticResource OffstreamAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="{Binding HasPendingChanges, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Static res:Strings.MetadataWillChange}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            The editor for whichever row is picked.

            Two versions of this lived inside the row and both failed the same way: the panel was
            larger than the box it opened in. The third failure was measured rather than argued
            about — 539 device-independent pixels of editor inside a 347-pixel viewport — which is
            a deficit no amount of tightening closes, because even a perfect fit leaves the list
            showing exactly one file.

            So it is a pane instead. It is always the same height, always in the same place, and
            changing the pick swaps its contents without moving anything else on the page. That
            also gives the list's selected row a job, which is why the highlight removed from it a
            change ago is back: it now marks the row this pane is editing rather than following
            the arrow keys around meaning nothing.

            One scroll region, not two. The fields and the search box fit without scrolling; the
            results push past the bottom only once a search has returned some, and then the whole
            pane scrolls rather than a box nested inside it.
        -->
        <DataTemplate x:Key="LibraryEditorTemplate" DataType="{x:Type vm:LibraryTrackViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Title, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />

                    <TextBlock Style="{StaticResource OffstreamHintStyle}"
                               Text="{Binding FileName, Mode=OneTime}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               ToolTip="{Binding Path, Mode=OneTime}" />

                    <Border Margin="0,8,0,0"
                            BorderBrush="{StaticResource OffstreamRowSeparatorBrush}"
                            BorderThickness="0,1,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Padding="0,0,12,0"
                              VerticalScrollBarVisibility="Auto">
                    <!--
                        Capped rather than filling the pane. These fields hold a song title, not a
                        paragraph, and a box eight hundred pixels wide for the word "Renegade"
                        puts the caret an inch from the label that names it.

                        The cap is a star column with a MaxWidth beside an empty Auto one, not a
                        MaxWidth on the panel itself. A panel aligned Left is arranged at its
                        *desired* width, and a Grid's desired width is what its content asked for
                        — so capping it that way collapsed every star column onto its own text and
                        left four boxes each sized to the word inside it.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="620" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                            Two columns, not ten stacked boxes. Measured at the shell's minimum
                            window the pane is 444 DIP wide and its scrolling region 347 DIP tall,
                            while a field costs 65 DIP of height and reads perfectly well at half
                            that width — the numeric boxes are 216 DIP and nobody has trouble with
                            them. Stacked, the ten fields came to 650 DIP and put seven of them
                            below the fold, where a scroll bar is the only evidence they exist.
                            Paired, they come to 390 DIP: one row over at the smallest window
                            Offstream allows, and all of it visible at any size anybody uses.

                            Title and copyright span both columns because neither is a short value
                            — one is what the row is named after, and the other is a sentence.
                        -->
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Grid.Column="0" Style="{StaticResource MetadataFieldStyle}">
                                <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.MetadataFieldTitle}" />

                                <TextBox x:Name="TitleBox"
                                         AutomationProperties.HelpText="{x:Static res:Strings.MetadataFieldTitle}"
                                         AutomationProperties.Name="{x:Static res:Strings.MetadataFieldTitle}"
                                         Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                <TextBlock Style="{StaticResource MetadataWasStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Visibility="{Binding HasTitleChange, Converter={StaticResource BooleanToVisibility}}">
                                    <Run Text="{x:Static res:Strings.MetadataWasLabel}" />
                                    <Run Text="{Binding CurrentTitle, Mode=OneTime}" />
                                </TextBlock>

                                <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=TitleBox, Path=(Validation.Errors)/ErrorContent}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource MetadataFieldStyle}">
                                <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.MetadataFieldArtist}" />

                                <TextBox x:Name="ArtistBox"
                                         AutomationProperties.HelpText="{x:Static res:Strings.MetadataFieldArtist}"
                                         AutomationProperties.Name="{x:Static res:Strings.MetadataFieldArtist}"
                                         Text="{Binding Artist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                <TextBlock Style="{StaticResource MetadataWasStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Visibility="{Binding HasArtistChange, Converter={StaticResource BooleanToVisibility}}">
                                    <Run Text="{x:Static res:Strings.MetadataWasLabel}" />
                                    <Run Text="{Binding CurrentArtist, Mode=OneTime}" />
                                </TextBlock>

                                <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=ArtistBox, Path=(Validation.Errors)/ErrorContent}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource MetadataFieldStyle}">
                                <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.MetadataFieldAlbumArtist}" />

                                <TextBox x:Name="AlbumArtistBox"
                                         AutomationProperties.HelpText="{x:Static res:Strings.MetadataListHint}"
                                         AutomationProperties.Name="{x:Static res:Strings.MetadataFieldAlbumArtist}"
                                                                     ToolTip="{x:Static res:Strings.MetadataListHint}"
                                         Text="{Binding AlbumArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource MetadataWasStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Visibility="{Binding HasAlbumArtistChange, Converter={StaticResource BooleanToVisibility}}">
                                    <Run Text="{x:Static res:Strings.MetadataWasLabel}" />
                                    <Run Text="{Binding CurrentAlbumArtist, Mode=OneTime}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource MetadataFieldStyle}">
                                <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.MetadataFieldAlbum}" />

                                <TextBox x:Name="AlbumBox"
                                         AutomationProperties.HelpText="{x:Static res:Strings.MetadataFieldAlbum}"
                                         AutomationProperties.Name="{x:Static res:Strings.MetadataFieldAlbum}"
                                         Text="{Binding Album, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource MetadataWasStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Visibility="{Binding HasAlbumChange, Converter={StaticResource BooleanToVisibility}}">
                                    <Run Text="{x:Static res:Strings.MetadataWasLabel}" />
                                    <Run Text="{Binding CurrentAlbum, Mode=OneTime}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource MetadataFieldStyle}">
                                <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.MetadataFieldGenre}" />

                                <TextBox x:Name="GenresBox"
                                         AutomationProperties.HelpText="{x:Static res:Strings.MetadataListHint}"
                                         AutomationProperties.Name="{x:Static res:Strings.MetadataFieldGenre}"
                                                                     ToolTip="{x:Static res:Strings.MetadataListHint}"
                                         Text="{Binding Genres, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource MetadataWasStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Visibility="{Binding HasGenreChange, Converter={StaticResource BooleanToVisibility}}">
                                    <Run Text="{x:Static res:Strings.MetadataWasLabel}" />
                                    <Run Text="{Binding CurrentGenres, Mode=OneTime}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource MetadataFieldStyle}">
                                <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.MetadataFieldYear}" />

                                <TextBox x:Name="YearBox"
                                         AutomationProperties.HelpText="{x:Static res:Strings.MetadataFieldYear}"
                                         AutomationProperties.Name="{x:Static res:Strings.MetadataFieldYear}"
                                         Text="{Binding Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                <TextBlock Style="{StaticResource MetadataWasStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Visibility="{Binding HasYearChange, Converter={StaticResource BooleanToVisibility}}">
                                    <Run Text="{x:Static res:Strings.MetadataWasLabel}" />
                                    <Run Text="{Binding CurrentYear, Mode=OneTime}" />
                                </TextBlock>

                                <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=YearBox, Path=(Validation.Errors)/ErrorContent}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="2" Style="{StaticResource MetadataFieldStyle}">
                                <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.MetadataFieldDisc}" />

                                <TextBox x:Name="DiscBox"
                                         AutomationProperties.HelpText="{x:Static res:Strings.MetadataFieldDisc}"
                                         AutomationProperties.Name="{x:Static res:Strings.MetadataFieldDisc}"
                                         Text="{Binding Disc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                <TextBlock Style="{StaticResource MetadataWasStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Visibility="{Binding HasDiscChange, Converter={StaticResource BooleanToVisibility}}">
                                    <Run Text="{x:Static res:Strings.MetadataWasLabel}" />
                                    <Run Text="{Binding CurrentDisc, Mode=OneTime}" />
                                </TextBlock>

                                <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=DiscBox, Path=(Validation.Errors)/ErrorContent}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Style="{StaticResource MetadataFieldStyle}">
                                <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.MetadataFieldTrackNumber}" />

                                <TextBox x:Name="TrackNumberBox"
                                         AutomationProperties.HelpText="{x:Static res:Strings.MetadataFieldTrackNumber}"
                                         AutomationProperties.Name="{x:Static res:Strings.MetadataFieldTrackNumber}"
                                         Text="{Binding TrackNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                <TextBlock Style="{StaticResource MetadataWasStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Visibility="{Binding HasTrackNumberChange, Converter={StaticResource BooleanToVisibility}}">
                                    <Run Text="{x:Static res:Strings.MetadataWasLabel}" />
                                    <Run Text="{Binding CurrentTrackNumber, Mode=OneTime}" />
                                </TextBlock>

                                <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=TrackNumberBox, Path=(Validation.Errors)/ErrorContent}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="2" Style="{StaticResource MetadataFieldStyle}">
                                <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.MetadataFieldTrackCount}" />

                                <TextBox x:Name="TrackCountBox"
                                         AutomationProperties.HelpText="{x:Static res:Strings.MetadataFieldTrackCount}"
                                         AutomationProperties.Name="{x:Static res:Strings.MetadataFieldTrackCount}"
                                         Text="{Binding TrackCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                <TextBlock Style="{StaticResource MetadataWasStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Visibility="{Binding HasTrackCountChange, Converter={StaticResource BooleanToVisibility}}">
                                    <Run Text="{x:Static res:Strings.MetadataWasLabel}" />
                                    <Run Text="{Binding CurrentTrackCount, Mode=OneTime}" />
                                </TextBlock>

                                <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=TrackCountBox, Path=(Validation.Errors)/ErrorContent}" />
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Grid.Column="0" Style="{StaticResource MetadataFieldStyle}">
                                <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.MetadataFieldCopyright}" />

                                <TextBox x:Name="CopyrightBox"
                                         AutomationProperties.HelpText="{x:Static res:Strings.MetadataFieldCopyright}"
                                         AutomationProperties.Name="{x:Static res:Strings.MetadataFieldCopyright}"
                                         Text="{Binding Copyright, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource MetadataWasStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Visibility="{Binding HasCopyrightChange, Converter={StaticResource BooleanToVisibility}}">
                                    <Run Text="{x:Static res:Strings.MetadataWasLabel}" />
                                    <Run Text="{Binding CurrentCopyright, Mode=OneTime}" />
                                </TextBlock>
                            </StackPanel>

                            <!--
                                Artwork is the one tag with no box, because a picture is not
                                something to type. It is still written by Save, so a row can say
                                "will change" with every field beside it matching the file — and a
                                badge with no visible cause reads as a bug rather than as
                                information. Before and after, side by side, is the only way a
                                changed picture is visible at all.
                            -->
                            <StackPanel Grid.Row="6"
                                        Grid.ColumnSpan="3"
                                        Grid.Column="0"
                                        Style="{StaticResource MetadataFieldStyle}"
                                        Visibility="{Binding HasCoverArtChange, Converter={StaticResource BooleanToVisibility}}">
                                <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.MetadataFieldArtwork}" />

                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <StackPanel Margin="0,0,14,0">
                                        <Image Width="44"
                                               Height="44"
                                               Source="{Binding ExistingCoverArt, Mode=OneTime}"
                                               Stretch="UniformToFill" />

                                        <TextBlock Style="{StaticResource MetadataWasStyle}" Text="{x:Static res:Strings.MetadataCoverBefore}" />
                                    </StackPanel>

                                    <StackPanel>
                                        <Image Width="44"
                                               Height="44"
                                               Source="{Binding SuggestedCoverArtSource, Mode=OneWay}"
                                               Stretch="UniformToFill" />

                                        <TextBlock Style="{StaticResource MetadataWasStyle}" Text="{x:Static res:Strings.MetadataCoverAfter}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!--
                    The answer to a wrong match, pinned to the bottom of the pane rather than left
                    to follow the fields down.

                    It needs its own search rather than another Re-fetch because the automatic
                    lookup builds its query from the file and then rejects any result whose artist
                    disagrees with it — so the one case it cannot help with is a file whose artist
                    is wrong, and asking it again returns the same answer. This asks Spotify what
                    the user typed and shows everything it says.

                    Pinned because the results are the thing the user just asked for. With the
                    whole pane scrolling as one, ten results appeared below the fold behind a
                    scroll bar, and the only sign that the search had worked at all was that the
                    bar got smaller. The fields scroll in the space above instead: they are what
                    the user is willing to go looking for, having already read them.
                -->
                <StackPanel Grid.Row="2">
                    <Border Margin="0,8,0,10"
                            BorderBrush="{StaticResource OffstreamRowSeparatorBrush}"
                            BorderThickness="0,1,0,0" />

                    <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.MetadataWrongMatchHeading}" />

                    <!--
                        Both buttons sit on the line with the box because they are two ways of
                        asking the same question, and neither is worth a row of its own.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.HelpText="{x:Static res:Strings.MetadataSearchHelp}"
                                    AutomationProperties.Name="{x:Static res:Strings.MetadataSearchLabel}"
                                    PlaceholderText="{x:Static res:Strings.MetadataSearchLabel}"
                                    Text="{Binding MatchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="{x:Static res:Strings.MetadataSearchHelp}" />

                        <ui:Button Grid.Column="1"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Command="{Binding DataContext.SearchMatchesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"
                                   Content="{x:Static res:Strings.MetadataSearchAction}"
                                   IsEnabled="{Binding IsNotSearching, Mode=OneWay}"
                                   ToolTip="{x:Static res:Strings.MetadataSearchHelp}" />

                        <ui:Button Grid.Column="2"
                                   VerticalAlignment="Center"
                                   AutomationProperties.HelpText="{x:Static res:Strings.MetadataRefetchHelp}"
                                   Command="{Binding DataContext.RefetchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"
                                   Content="{x:Static res:Strings.MetadataRefetch}"
                                   ToolTip="{x:Static res:Strings.MetadataRefetchHelp}" />
                    </Grid>

                    <TextBlock Margin="0,6,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource MetadataWasStyle}"
                               Text="{x:Static res:Strings.MetadataSearching}"
                               Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibility}}" />

                    <TextBlock Margin="0,6,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource MetadataWasStyle}"
                               Text="{Binding SearchMessage, Mode=OneWay}"
                               TextWrapping="Wrap" />

                    <!--
                        Capped and scrollable. Ten results is a normal answer from Spotify and
                        they cannot all be shown — but the cap is on the box, not on the search:
                        the whole point of this list is that the user sees what Spotify actually
                        returned rather than the one answer the matcher liked.
                    -->
                    <ScrollViewer MaxHeight="132"
                                  Margin="0,8,0,0"
                                  Padding="0,0,12,0"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasCandidates, Converter={StaticResource BooleanToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Candidates, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LibraryMatchViewModel}">
                                    <Border Margin="0,0,0,6"
                                            Padding="10,7"
                                            Background="{StaticResource OffstreamSurfaceBrush}"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title, Mode=OneTime}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />

                                                <TextBlock Style="{StaticResource MetadataWasStyle}"
                                                           Text="{Binding Summary, Mode=OneTime}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                            </StackPanel>

                                            <ui:Button Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       AutomationProperties.HelpText="{x:Static res:Strings.MetadataUseMatchHelp}"
                                                       Command="{Binding DataContext.UseMatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       Content="{x:Static res:Strings.MetadataUseMatch}"
                                                       ToolTip="{x:Static res:Strings.MetadataUseMatchHelp}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        Repairing tags on files that already exist.

        The page is three steps in one direction and only the last one writes: scan reads, fetch
        proposes, save commits. Keeping them as three buttons rather than one "fix my library"
        action is deliberate — an automatic match is wrong often enough that the review step is
        the feature, not friction in front of it.

        Below the buttons it is a list beside an editor. That split is what makes the review step
        usable: the library stays on screen while one of its files is being corrected, and the
        pane holding the correction never changes size or position as the pick moves through it.
    -->
    <Border Padding="12" Style="{StaticResource OffstreamCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                What the page is for is a tooltip on its heading rather than a paragraph under it,
                the same trade the Advanced page makes for its settings: a line of prose costs
                every row below it a share of a window that has none to give, and this one cost
                the list forty pixels it needed more.
            -->
            <ContentControl Grid.Row="0"
                            Content="{x:Static res:Strings.MetadataHeading}"
                            Style="{StaticResource OffstreamGroupHeaderStyle}"
                            ToolTip="{x:Static res:Strings.MetadataIntro}" />

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource OffstreamFieldLabelStyle}"
                           Text="{x:Static res:Strings.MetadataFolderLabel}" />

                <TextBox Grid.Column="1"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         AutomationProperties.AutomationId="MetadataFolder"
                         AutomationProperties.HelpText="{x:Static res:Strings.MetadataFolderHelp}"
                         AutomationProperties.Name="{x:Static res:Strings.MetadataFolderLabel}"
                         Text="{Binding Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static res:Strings.MetadataFolderHelp}" />

                <ui:Button Grid.Column="2"
                           AutomationProperties.AutomationId="MetadataBrowse"
                           Command="{Binding BrowseCommand}"
                           Content="{x:Static res:Strings.MetadataBrowse}"
                           IsEnabled="{Binding IsIdle, Mode=OneWay}" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0"
                               AutomationProperties.AutomationId="MetadataScan"
                               AutomationProperties.HelpText="{x:Static res:Strings.MetadataScanHelp}"
                               Command="{Binding ScanCommand}"
                               Content="{x:Static res:Strings.MetadataScan}"
                               IsEnabled="{Binding IsIdle, Mode=OneWay}"
                               ToolTip="{x:Static res:Strings.MetadataScanHelp}" />

                    <ui:Button Margin="0,0,8,0"
                               AutomationProperties.AutomationId="MetadataAutoFetch"
                               AutomationProperties.HelpText="{x:Static res:Strings.MetadataAutoFetchHelp}"
                               Command="{Binding AutoFetchCommand}"
                               Content="{x:Static res:Strings.MetadataAutoFetch}"
                               IsEnabled="{Binding IsIdle, Mode=OneWay}"
                               ToolTip="{x:Static res:Strings.MetadataAutoFetchHelp}" />

                    <ui:Button Appearance="Primary"
                               AutomationProperties.AutomationId="MetadataSaveSelected"
                               AutomationProperties.HelpText="{x:Static res:Strings.MetadataSaveHelp}"
                               Command="{Binding SaveSelectedCommand}"
                               Content="{x:Static res:Strings.MetadataSaveSelected}"
                               IsEnabled="{Binding IsIdle, Mode=OneWay}"
                               ToolTip="{x:Static res:Strings.MetadataSaveHelp}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"
                           Style="{StaticResource OffstreamHintStyle}"
                           Text="{Binding StatusMessage, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.1*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        The filter narrows what is drawn and nothing else. It sits over the list
                        rather than beside the buttons because it belongs to the list: the buttons
                        act on the whole library whatever is typed here, and putting it in their
                        row would suggest otherwise.
                    -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,8"
                          Visibility="{Binding HasTracks, Converter={StaticResource BooleanToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="MetadataFilter"
                                    AutomationProperties.HelpText="{x:Static res:Strings.MetadataFilterHelp}"
                                    AutomationProperties.Name="{x:Static res:Strings.MetadataFilterLabel}"
                                    PlaceholderText="{x:Static res:Strings.MetadataFilterPlaceholder}"
                                    Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="{x:Static res:Strings.MetadataFilterHelp}" />

                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource OffstreamHintStyle}"
                                   Text="{Binding FilterSummary, Mode=OneWay}"
                                   Visibility="{Binding IsFiltered, Converter={StaticResource BooleanToVisibility}}" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Margin="4,12,0,0"
                               VerticalAlignment="Top"
                               Text="{x:Static res:Strings.MetadataEmpty}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource OffstreamHintStyle}" TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTracks, Mode=OneWay}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Row="1"
                               Margin="4,12,0,0"
                               VerticalAlignment="Top"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource OffstreamHintStyle}"
                               Text="{x:Static res:Strings.MetadataNoMatches}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasNoMatches, Converter={StaticResource BooleanToVisibility}}" />

                    <!--
                        Virtualised: a music folder is thousands of files, and each row carries a
                        decoded thumbnail. Without recycling, scanning a real library builds every
                        one of them up front and the page stops responding before it finishes
                        drawing.

                        Horizontal scrolling is disabled rather than automatic, which is what
                        forces the rows to be measured at the width actually available. See the
                        row template.

                        Scrolling is by pixel, not by item. A row here is a three-line block, so
                        the default — three *items* per wheel notch — moved the list most of a
                        screen at a time and made it unusable with a mouse.
                    -->
                    <ListBox Grid.Row="1"
                             AutomationProperties.AutomationId="MetadataTrackList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemTemplate="{StaticResource LibraryTrackTemplate}"
                             ItemsSource="{Binding VisibleTracks, Mode=OneWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                             Visibility="{Binding HasTracks, Converter={StaticResource BooleanToVisibility}}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <!--
                            The selected row is marked, but quietly. The themed container paints a
                            saturated fill and an accent bar down the side, which on a list of
                            three-line rows reads as an alarm rather than a pointer — and it was
                            worse than useless while nothing acted on the selection at all. Now
                            the pane on the right is what the selection means, so the row needs to
                            say which one it is showing: a tinted background and a narrow accent
                            edge, and no change to the text.

                            The template is replaced rather than the brushes overridden, because
                            setting the brushes leaves the themed accent bar in place underneath.
                        -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Pick"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="3,0,0,0">
                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Pick" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                    <Setter TargetName="Pick" Property="BorderBrush" Value="{StaticResource OffstreamAccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>

                <Border Grid.Column="2"
                        Padding="16,14"
                        Background="{StaticResource OffstreamWellBrush}"
                        BorderBrush="{StaticResource OffstreamRowSeparatorBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding HasTracks, Converter={StaticResource BooleanToVisibility}}">
                    <Grid>
                        <TextBlock VerticalAlignment="Top"
                                   Text="{x:Static res:Strings.MetadataNoSelection}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource OffstreamHintStyle}" TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelection, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ContentControl HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.AutomationId="MetadataEditor"
                                        AutomationProperties.Name="{x:Static res:Strings.MetadataEditorHeading}"
                                        Content="{Binding SelectedTrack, Mode=OneWay}"
                                        ContentTemplate="{StaticResource LibraryEditorTemplate}"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibility}}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>

</UserControl>
