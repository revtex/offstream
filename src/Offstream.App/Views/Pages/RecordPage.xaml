<Page x:Class="Offstream.App.Views.Pages.RecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Offstream.App.Views.Controls"
      xmlns:res="clr-namespace:Offstream.App.Resources"
      xmlns:serilog="clr-namespace:Serilog.Events;assembly=Serilog"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Offstream.App.ViewModels"
      ScrollViewer.CanContentScroll="False"
      Title="Record">

    <!--
        ScrollViewer.CanContentScroll="False" is load-bearing, and is not about this page's own
        scrolling. WPF-UI's NavigationViewContentPresenter reads it on navigation
        (IsDynamicScrollViewerEnabled = ScrollViewer.GetCanContentScroll(page)) and swaps its
        template to one that wraps the page in a DynamicScrollViewer — and its static constructor
        defaults the property to True for every Page. Inside that scroller the page is measured
        with infinite height, so the star row below resolves to its content's size instead of the
        viewport: the log ListBox lays out every retained line and the card grows off the bottom
        of the window. Opting out selects the plain ContentPresenter template, the star row gets
        the real viewport height back, and the log scrolls inside its own box at a fixed size.

        The Settings and Advanced pages deliberately keep the default — they are long forms that
        genuinely want to scroll as a whole.
    -->

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!--
            One line of the activity log. Level is carried on the entry rather than parsed back
            out of the text, so a warning is a colour and not a substring match.
        -->
        <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type vm:LogEntry}">
            <TextBlock Text="{Binding Text, Mode=OneTime}" TextWrapping="NoWrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="{x:Static serilog:LogEventLevel.Warning}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="{x:Static serilog:LogEventLevel.Error}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="{x:Static serilog:LogEventLevel.Fatal}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource OffstreamPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The display, and the buttons beside it.

            One panel rather than two stacked cards: on the instrument this borrows from, the
            transport state, the counter, what is being recorded and the meters are one piece of
            glass, and splitting them into separate cards with a Fluent gap between undoes most of
            what the borrowing is for. The two transport buttons stay outside it, as real controls
            in the app's own style — an LCD is not clickable, and styling a button to look like
            one would be a lie about what can be pressed.
        -->
        <ui:Card Grid.Row="0" Margin="{StaticResource OffstreamStackGap}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="0,10,0,0"
                        Background="{StaticResource OffstreamLcdPanelBrush}"
                        BorderBrush="{StaticResource OffstreamLcdBezelBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            Margin 10 on the left matches the meter's own internal padding below,
                            so the indicator block and the L/R channel letters share an edge.
                        -->
                        <Grid Grid.Row="0" Margin="10,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--
                                The indicator field. Three states, in the vocabulary every
                                recorder uses: solid and inverted while audio is being written,
                                blinking while armed and waiting for a track, static and outlined
                                while stopped.

                                The blink carries the distinction the transport buttons cannot,
                                since armed and capturing are both "running" and both show Stop.
                                It is discrete key frames rather than a fade because an LCD
                                segment has no in-between — a cross-fade would read as a glow, not
                                as a driven segment — and it is a whole second per cycle, well
                                under the rate that matters for photosensitivity.
                            -->
                            <Border Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    MinWidth="46"
                                    Margin="0,0,12,0"
                                    Padding="6,3"
                                    VerticalAlignment="Center"
                                    BorderBrush="{StaticResource OffstreamLcdSegmentBrush}"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCapturing, Mode=OneWay}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource OffstreamLcdSegmentBrush}" />
                                            </DataTrigger>

                                            <!--
                                                Gated on the system's own animation setting: a
                                                user who turned animations off asked for this. No
                                                information is lost when it is off, because armed
                                                still reads as outlined against capturing's
                                                inverted block.
                                            -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsArmed, Mode=OneWay}" Value="True" />
                                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                                </MultiDataTrigger.Conditions>

                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="BlinkWhileArmed">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1">
                                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>

                                                <MultiDataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="BlinkWhileArmed" />
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock HorizontalAlignment="Center"
                                           AutomationProperties.AutomationId="RecordTransport"
                                           FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Text="{Binding Transport, Mode=OneWay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource OffstreamLcdSegmentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCapturing, Mode=OneWay}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource OffstreamLcdPanelBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       VerticalAlignment="Bottom"
                                       AutomationProperties.AutomationId="RecordNowPlaying"
                                       FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                       FontSize="15"
                                       Foreground="{StaticResource OffstreamLcdSegmentBrush}"
                                       Text="{Binding NowPlaying, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding NowPlaying, Mode=OneWay}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,2,0,0"
                                       AutomationProperties.AutomationId="RecordStatus"
                                       FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                       FontSize="11"
                                       Foreground="{StaticResource OffstreamLcdInkBrush}"
                                       Text="{Binding Status, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Status, Mode=OneWay}" />

                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Bottom"
                                       AutomationProperties.AutomationId="RecordElapsed"
                                       FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                       FontSize="22"
                                       Foreground="{StaticResource OffstreamLcdSegmentBrush}"
                                       Text="{Binding ElapsedText, Mode=OneWay}" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Margin="16,2,0,0"
                                       HorizontalAlignment="Right"
                                       AutomationProperties.AutomationId="RecordFormat"
                                       FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                       FontSize="11"
                                       Foreground="{StaticResource OffstreamLcdInkBrush}"
                                       Text="{Binding FormatText, Mode=OneWay}" />
                        </Grid>

                        <!--
                            The meter sizes itself: it holds the height its parts need to stay
                            legible and takes whatever width is going. Its bezel is off because it
                            is already inside one.
                        -->
                        <controls:LcdMeterView Grid.Row="1"
                                               AutomationProperties.AutomationId="RecordLevelMeter"
                                               AutomationProperties.Name="{x:Static res:Strings.RecordLevelLabel}"
                                               BezelBrush="Transparent"
                                               FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                               GhostBrush="{StaticResource OffstreamLcdGhostBrush}"
                                               InkBrush="{StaticResource OffstreamLcdInkBrush}"
                                               Level="{Binding Level, Mode=OneWay}"
                                               PanelBrush="{StaticResource OffstreamLcdPanelBrush}"
                                               SegmentBrush="{StaticResource OffstreamLcdSegmentBrush}" />
                    </Grid>
                </Border>

                <!--
                    Two buttons in one cell rather than one that relabels itself: start and stop
                    are different actions, and a control that changes what it does under the
                    pointer is the classic way to stop a recording by accident.
                -->
                <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <ui:Button Appearance="Primary"
                               AutomationProperties.AutomationId="RecordStartButton"
                               Command="{Binding StartCommand}"
                               Content="{x:Static res:Strings.RecordStart}"
                               Icon="{ui:SymbolIcon Record24}"
                               Visibility="{Binding IsIdle, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                    <ui:Button Appearance="Danger"
                               AutomationProperties.AutomationId="RecordStopButton"
                               Command="{Binding StopCommand}"
                               Content="{x:Static res:Strings.RecordStop}"
                               Icon="{ui:SymbolIcon Stop24}"
                               Visibility="{Binding IsRecording, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="{StaticResource OffstreamStackGap}"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource OffstreamIdleBrush}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Text="{x:Static res:Strings.RecordFilterLabel}" />
                <ComboBox Width="180"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          AutomationProperties.AutomationId="RecordLogFilter"
                          AutomationProperties.Name="{x:Static res:Strings.RecordFilterLabel}"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding FilterOptions, Mode=OneTime}"
                          SelectedValue="{Binding Filter, Mode=TwoWay}"
                          SelectedValuePath="Value" />

                <ui:Button Margin="8,0,0,0"
                           AutomationProperties.AutomationId="RecordCopyLogButton"
                           Command="{Binding CopyLogCommand}"
                           Content="{x:Static res:Strings.RecordCopyLog}"
                           Icon="{ui:SymbolIcon Copy24}" />
                <ui:Button Margin="8,0,0,0"
                           AutomationProperties.AutomationId="RecordClearLogButton"
                           Command="{Binding ClearLogCommand}"
                           Content="{x:Static res:Strings.RecordClearLog}"
                           Icon="{ui:SymbolIcon Delete24}" />
            </StackPanel>

            <ui:Card Grid.Row="1">
                <ListBox x:Name="LogList"
                         AutomationProperties.AutomationId="RecordLogList"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="{StaticResource OffstreamMonoFontFamily}"
                         FontSize="{StaticResource OffstreamMonoFontSize}"
                         ItemTemplate="{StaticResource LogEntryTemplate}"
                         ItemsSource="{Binding LogLines, Mode=OneWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" />
            </ui:Card>
        </Grid>
    </Grid>

</Page>
