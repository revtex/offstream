<Page x:Class="Offstream.App.Views.Pages.RecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Offstream.App.Views.Controls"
      xmlns:res="clr-namespace:Offstream.App.Resources"
      xmlns:serilog="clr-namespace:Serilog.Events;assembly=Serilog"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Offstream.App.ViewModels"
      ScrollViewer.CanContentScroll="False"
      Title="Record">

    <!--
        ScrollViewer.CanContentScroll="False" is load-bearing, and is not about this page's own
        scrolling. WPF-UI's NavigationViewContentPresenter reads it on navigation
        (IsDynamicScrollViewerEnabled = ScrollViewer.GetCanContentScroll(page)) and swaps its
        template to one that wraps the page in a DynamicScrollViewer — and its static constructor
        defaults the property to True for every Page. Inside that scroller the page is measured
        with infinite height, so the star row below resolves to its content's size instead of the
        viewport: the log ListBox lays out every retained line and the card grows off the bottom
        of the window. Opting out selects the plain ContentPresenter template, the star row gets
        the real viewport height back, and the log scrolls inside its own box at a fixed size.

        The Settings and Advanced pages deliberately keep the default — they are long forms that
        genuinely want to scroll as a whole.
    -->

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!--
            One line of the activity log. Level is carried on the entry rather than parsed back
            out of the text, so a warning is a colour and not a substring match.
        -->
        <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type vm:LogEntry}">
            <TextBlock Text="{Binding Text, Mode=OneTime}" TextWrapping="NoWrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="{x:Static serilog:LogEventLevel.Warning}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="{x:Static serilog:LogEventLevel.Error}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="{x:Static serilog:LogEventLevel.Fatal}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource OffstreamPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Transport. The track name and the elapsed counter sit next to the button that governs
            them, because together they answer the only question this page exists to answer: is it
            recording, and what.
        -->
        <ui:Card Grid.Row="0" Margin="{StaticResource OffstreamStackGap}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock AutomationProperties.AutomationId="RecordNowPlaying"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Text="{Binding NowPlaying, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding NowPlaying, Mode=OneWay}" />
                    <TextBlock Margin="0,4,0,0"
                               AutomationProperties.AutomationId="RecordStatus"
                               Foreground="{StaticResource OffstreamIdleBrush}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Text="{Binding Status, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="RecordElapsed"
                           FontFamily="{StaticResource OffstreamMonoFontFamily}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Text="{Binding ElapsedText, Mode=OneWay}" />

                <!--
                    Two buttons in one cell rather than one that relabels itself: start and stop
                    are different actions, and a control that changes what it does under the
                    pointer is the classic way to stop a recording by accident.
                -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <ui:Button Appearance="Primary"
                               AutomationProperties.AutomationId="RecordStartButton"
                               Command="{Binding StartCommand}"
                               Content="{x:Static res:Strings.RecordStart}"
                               Icon="{ui:SymbolIcon Record24}"
                               Visibility="{Binding IsIdle, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                    <ui:Button Appearance="Danger"
                               AutomationProperties.AutomationId="RecordStopButton"
                               Command="{Binding StopCommand}"
                               Content="{x:Static res:Strings.RecordStop}"
                               Icon="{ui:SymbolIcon Stop24}"
                               Visibility="{Binding IsRecording, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
            </Grid>
        </ui:Card>

        <!--
            The level meter. Fixed height: it is a signal, not content, and letting it take the
            slack in the layout would push the activity log off a short window.
        -->
        <ui:Card Grid.Row="1" Margin="{StaticResource OffstreamStackGap}">
            <controls:LevelMeterView Height="20"
                                     AutomationProperties.AutomationId="RecordLevelMeter"
                                     AutomationProperties.Name="{x:Static res:Strings.RecordLevelLabel}"
                                     Fill="{StaticResource OffstreamRecordingBrush}"
                                     Level="{Binding Level, Mode=OneWay}"
                                     PeakBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                     TrackBrush="{DynamicResource ControlAltFillColorTertiaryBrush}" />
        </ui:Card>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="{StaticResource OffstreamStackGap}"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource OffstreamIdleBrush}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Text="{x:Static res:Strings.RecordFilterLabel}" />
                <ComboBox Width="180"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          AutomationProperties.AutomationId="RecordLogFilter"
                          AutomationProperties.Name="{x:Static res:Strings.RecordFilterLabel}"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding FilterOptions, Mode=OneTime}"
                          SelectedValue="{Binding Filter, Mode=TwoWay}"
                          SelectedValuePath="Value" />

                <ui:Button Margin="8,0,0,0"
                           AutomationProperties.AutomationId="RecordCopyLogButton"
                           Command="{Binding CopyLogCommand}"
                           Content="{x:Static res:Strings.RecordCopyLog}"
                           Icon="{ui:SymbolIcon Copy24}" />
                <ui:Button Margin="8,0,0,0"
                           AutomationProperties.AutomationId="RecordClearLogButton"
                           Command="{Binding ClearLogCommand}"
                           Content="{x:Static res:Strings.RecordClearLog}"
                           Icon="{ui:SymbolIcon Delete24}" />
            </StackPanel>

            <ui:Card Grid.Row="1">
                <ListBox x:Name="LogList"
                         AutomationProperties.AutomationId="RecordLogList"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="{StaticResource OffstreamMonoFontFamily}"
                         FontSize="{StaticResource OffstreamMonoFontSize}"
                         ItemTemplate="{StaticResource LogEntryTemplate}"
                         ItemsSource="{Binding LogLines, Mode=OneWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" />
            </ui:Card>
        </Grid>
    </Grid>

</Page>
