<UserControl x:Class="Offstream.App.Views.Pages.RecordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Offstream.App.Views.Controls"
             xmlns:res="clr-namespace:Offstream.App.Resources"
             xmlns:serilog="clr-namespace:Serilog.Events;assembly=Serilog"
             xmlns:svc="clr-namespace:Offstream.App.Services"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Offstream.App.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!--
            One line of the activity log. Level is carried on the entry rather than parsed back
            out of the text, so a warning is a colour and not a substring match.
        -->
        <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type vm:LogEntry}">
            <TextBlock Text="{Binding Text, Mode=OneTime}" TextWrapping="NoWrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="{x:Static serilog:LogEventLevel.Warning}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="{x:Static serilog:LogEventLevel.Error}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="{x:Static serilog:LogEventLevel.Fatal}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <!--
            One readiness check, as a pill.

            A dot rather than an icon, and colour carrying only the severity: the text says what
            is wrong, so the colour is a way to find the row rather than the only way to read it.
            Three states because "will not start" and "will start worse" are genuinely different
            answers and collapsing them would make the panel either alarmist or useless.
        -->
        <DataTemplate x:Key="ReadinessCheckTemplate" DataType="{x:Type svc:ReadinessCheck}">
            <Border Margin="0,0,8,6"
                    Padding="9,4"
                    Background="{StaticResource OffstreamWellBrush}"
                    BorderBrush="{StaticResource OffstreamSurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ToolTip="{Binding Detail, Mode=OneTime}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7"
                             Height="7"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource OffstreamReadyBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State, Mode=OneTime}" Value="{x:Static svc:ReadinessState.Degraded}">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State, Mode=OneTime}" Value="{x:Static svc:ReadinessState.Blocked}">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="{Binding Name, Mode=OneTime}" />

                    <TextBlock MaxWidth="240"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource OffstreamIdleBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="{Binding Detail, Mode=OneTime}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
            One saved recording. Name on top, where it landed underneath, length on the right.

            The reveal button is explicit rather than a double-click on the row: a list whose
            rows do something on click has to be discovered, and this one is read far more often
            than it is acted on.
        -->
        <DataTemplate x:Key="SavedRecordingTemplate" DataType="{x:Type vm:SavedRecording}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title, Mode=OneTime}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <TextBlock Foreground="{StaticResource OffstreamIdleBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="{Binding Detail, Mode=OneTime}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               ToolTip="{Binding Path, Mode=OneTime}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource OffstreamMonoFontFamily}"
                           FontSize="{StaticResource OffstreamMonoFontSize}"
                           Foreground="{StaticResource OffstreamIdleBrush}"
                           Text="{Binding Duration, Mode=OneTime}" />

                <ui:Button Grid.Column="2"
                           Padding="7,4"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="{x:Static res:Strings.RecordSavedOpen}"
                           Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           CommandParameter="{Binding}"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           ToolTip="{x:Static res:Strings.RecordSavedOpen}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Refusals only. The display says what state it is in through its own transport block,
            so the one thing worth a line of prose is the app declining to start - a missing
            ffmpeg, an endpoint that went away, settings that would not read. Above the panel
            rather than inside it, because a failure that renders as a slightly different idle
            state is a failure nobody notices.
        -->
        <ui:InfoBar Grid.Row="0"
                    Margin="0,0,0,12"
                    AutomationProperties.AutomationId="RecordProblem"
                    IsClosable="True"
                    IsOpen="{Binding HasProblem, Mode=OneWay}"
                    Message="{Binding Problem, Mode=OneWay}"
                    Severity="Error" />

        <!--
            The display. One panel: transport state and the counter on the top line, what is
            playing and what it is being written as on the second, the meters below. That is the
            order a field recorder puts them in, and the borrowing is the point - the whole face
            is legible at a glance to anyone who has held one.
        -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Background="{StaticResource OffstreamLcdGlassBrush}"
                BorderBrush="{StaticResource OffstreamLcdBezelBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <!--
                No Padding on the bezel: the breathing room is a Margin on the content instead.
                Padding shrinks the area every child gets, including the scanline overlay, which
                left the top and bottom strips of glass unscanned - two bands a shade lighter than
                the panel, running the full width and reading exactly like mismatched borders.
                Margin moves the content and leaves the overlay the whole face to cover.
            -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Margin 14 matches the meter's own internal padding, so every left edge lines up. -->
                <Grid Grid.Row="0" Margin="14,12,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        The indicator field. Three states, in the vocabulary every recorder uses:
                        solid and inverted while audio is being written, blinking while armed and
                        waiting for a track, static and outlined while stopped.

                        The blink carries the distinction the transport button cannot, since armed
                        and capturing are both "running" and both show Stop. Discrete key frames
                        rather than a fade because an LCD segment has no in-between - a cross-fade
                        would read as a glow, not as a driven segment - and a whole second per
                        cycle, well under the rate that matters for photosensitivity.
                    -->
                    <Border Grid.Column="0"
                            MinWidth="52"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            BorderBrush="{StaticResource OffstreamLcdSegmentBrush}"
                            BorderThickness="1"
                            CornerRadius="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing, Mode=OneWay}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource OffstreamLcdSegmentBrush}" />
                                    </DataTrigger>

                                    <!--
                                        Gated on the system's own animation setting: a user who
                                        turned animations off asked for this. No information is
                                        lost when it is off, because armed still reads as outlined
                                        against capturing's inverted block.
                                    -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsArmed, Mode=OneWay}" Value="True" />
                                            <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                        </MultiDataTrigger.Conditions>

                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="BlinkWhileArmed">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1">
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>

                                        <MultiDataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="BlinkWhileArmed" />
                                        </MultiDataTrigger.ExitActions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock HorizontalAlignment="Center"
                                   AutomationProperties.AutomationId="RecordTransport"
                                   FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Text="{Binding Transport, Mode=OneWay}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource OffstreamLcdSegmentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapturing, Mode=OneWay}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource OffstreamLcdPanelBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="RecordElapsed"
                               FontFamily="{StaticResource OffstreamMonoFontFamily}"
                               FontSize="28"
                               Foreground="{StaticResource OffstreamLcdSegmentBrush}"
                               Text="{Binding ElapsedText, Mode=OneWay}" />
                </Grid>

                <Grid Grid.Row="1" Margin="14,4,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="RecordNowPlaying"
                               FontFamily="{StaticResource OffstreamMonoFontFamily}"
                               FontSize="17"
                               Foreground="{StaticResource OffstreamLcdSegmentBrush}"
                               Text="{Binding NowPlaying, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding NowPlaying, Mode=OneWay}" />

                    <TextBlock Grid.Column="1"
                               Margin="16,0,0,0"
                               VerticalAlignment="Bottom"
                               AutomationProperties.AutomationId="RecordFormat"
                               FontFamily="{StaticResource OffstreamMonoFontFamily}"
                               FontSize="11"
                               Foreground="{StaticResource OffstreamLcdInkBrush}"
                               Text="{Binding FormatText, Mode=OneWay}" />
                </Grid>

                <!--
                    The meter draws no panel of its own - the bezel above already paints the
                    glass - but its cell grid still has to be opaque and still has to match what
                    shows through, which is what MaskBrush is for. The numeric readout is off
                    because the format line above already carries the technical figures.
                -->
                <controls:LcdMeterView Grid.Row="2"
                                       Margin="0,0,0,8"
                                       AutomationProperties.AutomationId="RecordLevelMeter"
                                       AutomationProperties.Name="{x:Static res:Strings.RecordLevelLabel}"
                                       BezelBrush="Transparent"
                                       FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                       GhostBrush="{StaticResource OffstreamLcdGhostBrush}"
                                       InkBrush="{StaticResource OffstreamLcdInkBrush}"
                                       Level="{Binding Level, Mode=OneWay}"
                                       MaskBrush="{StaticResource OffstreamLcdPanelBrush}"
                                       PanelBrush="Transparent"
                                       SegmentBrush="{StaticResource OffstreamLcdSegmentBrush}"
                                       ShowReadout="False"
                                       SpectrumBrush="{StaticResource OffstreamLcdSpectrumBrush}" />

                <!--
                    The scanlines go over everything, last child and spanning every row, because
                    that is where they are on the real thing: the line structure is the panel the
                    segments are behind, not a texture under them. Not hit-testable, so it never
                    intercepts the tooltip on the track name beneath it.
                -->
                <Border Grid.Row="0"
                        Grid.RowSpan="3"
                        Background="{StaticResource OffstreamLcdScanlineBrush}"
                        CornerRadius="3"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!--
            What the display cannot hold: the cover, the album the lookup found, where this
            recording is going, and what the session has produced so far.

            Below the panel rather than on it. The display is a field recorder's face and
            everything on it is segments — a colour photograph behind the glass would read as a
            different device. This is the paper label beside the machine.
        -->
        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="12"
                Style="{StaticResource OffstreamCardStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        The art is already on disk — the enricher fetches it to embed in the file
                        — so showing it costs a decode and nothing else. The placeholder keeps the
                        row's height fixed, so a track without art does not make the strip jump.
                    -->
                    <Border Grid.Column="0"
                            Width="56"
                            Height="56"
                            Margin="0,0,12,0"
                            Background="{StaticResource OffstreamWellBrush}"
                            BorderBrush="{StaticResource OffstreamSurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <ui:SymbolIcon AutomationProperties.Name="{x:Static res:Strings.RecordNoArt}"
                                           FontSize="22"
                                           Foreground="{StaticResource OffstreamIdleBrush}"
                                           Symbol="MusicNote224" />

                            <Image AutomationProperties.AutomationId="RecordCoverArt"
                                   Source="{Binding CoverArt, Mode=OneWay}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding HasCoverArt, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock AutomationProperties.AutomationId="RecordAlbum"
                                   Text="{Binding Album, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Visibility="{Binding HasAlbum, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

                        <StackPanel Margin="0,2,0,0"
                                    Orientation="Horizontal"
                                    Visibility="{Binding HasDestination, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Margin="0,0,8,0"
                                       Foreground="{StaticResource OffstreamIdleBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Static res:Strings.RecordDestinationLabel}" />

                            <TextBlock AutomationProperties.AutomationId="RecordDestination"
                                       FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                       FontSize="{StaticResource OffstreamMonoFontSize}"
                                       Text="{Binding Destination, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       ToolTip="{Binding Destination, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Session totals. Right-aligned so they stay put as the text beside them changes.  -->
                    <StackPanel Grid.Column="2"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasSaved, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock HorizontalAlignment="Right"
                                   AutomationProperties.AutomationId="RecordSessionTracks"
                                   Text="{Binding SavedCountText, Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="{StaticResource OffstreamIdleBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="{Binding SavedDurationText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!--
                    Readiness. Wrapped rather than a row, so a narrow window folds it instead of
                    truncating whichever check happened to be last.
                -->
                <ItemsControl Margin="0,10,0,-6"
                              AutomationProperties.AutomationId="RecordReadiness"
                              ItemTemplate="{StaticResource ReadinessCheckTemplate}"
                              ItemsSource="{Binding Readiness, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--
            What the session has written. Takes the slack in the layout, because it is the thing
            that grows and the thing a running session is actually watched for.
        -->
        <Border Grid.Row="3"
                Margin="0,0,0,12"
                Padding="12"
                Style="{StaticResource OffstreamCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0"
                                Margin="0,0,0,4"
                                Content="{x:Static res:Strings.RecordSavedSection}"
                                Style="{StaticResource OffstreamGroupHeaderStyle}" />

                <TextBlock Grid.Row="1"
                           Margin="2,6,0,0"
                           VerticalAlignment="Top"
                           Foreground="{StaticResource OffstreamIdleBrush}"
                           Text="{x:Static res:Strings.RecordSavedEmpty}">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSaved, Mode=OneWay}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox Grid.Row="1"
                         AutomationProperties.AutomationId="RecordSavedList"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemTemplate="{StaticResource SavedRecordingTemplate}"
                         ItemsSource="{Binding Saved, Mode=OneWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!--
            The activity log, collapsed.

            It used to be the whole page, which had it backwards: a log is what you open when
            something is wrong, and giving it the largest surface on the page made the tab look
            like a console with an instrument bolted on. Expanded it takes a fixed height and
            scrolls inside it, so opening the log never pushes the saved list off the page.
        -->
        <Expander Grid.Row="4"
                  AutomationProperties.AutomationId="RecordLogExpander"
                  Header="{x:Static res:Strings.RecordActivitySection}"
                  IsExpanded="{Binding IsLogExpanded, Mode=TwoWay}">
            <Border Padding="12" Style="{StaticResource OffstreamCardStyle}">
                <Grid Height="220">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <ComboBox Width="150"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="RecordLogFilter"
                                  AutomationProperties.Name="{x:Static res:Strings.RecordFilterLabel}"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding FilterOptions, Mode=OneTime}"
                                  SelectedValue="{Binding Filter, Mode=TwoWay}"
                                  SelectedValuePath="Value" />

                        <ui:Button Margin="0,0,8,0"
                                   AutomationProperties.AutomationId="RecordCopyLogButton"
                                   Command="{Binding CopyLogCommand}"
                                   Content="{x:Static res:Strings.RecordCopyLog}" />
                        <ui:Button AutomationProperties.AutomationId="RecordClearLogButton"
                                   Command="{Binding ClearLogCommand}"
                                   Content="{x:Static res:Strings.RecordClearLog}" />
                    </StackPanel>

                    <ListBox x:Name="LogList"
                             Grid.Row="1"
                             AutomationProperties.AutomationId="RecordLogList"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="{StaticResource OffstreamMonoFontFamily}"
                             FontSize="{StaticResource OffstreamMonoFontSize}"
                             ItemTemplate="{StaticResource LogEntryTemplate}"
                             ItemsSource="{Binding LogLines, Mode=OneWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" />
                </Grid>
            </Border>
        </Expander>
    </Grid>

</UserControl>
