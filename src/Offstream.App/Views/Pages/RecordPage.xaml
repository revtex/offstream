<Page x:Class="Offstream.App.Views.Pages.RecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:res="clr-namespace:Offstream.App.Resources"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Record">

    <Grid Margin="{StaticResource OffstreamPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="{StaticResource OffstreamStackGap}"
                   Foreground="{StaticResource OffstreamIdleBrush}"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Text="{Binding Status, Mode=OneWay}"
                   TextWrapping="Wrap" />

        <!--
            The activity log. Transport controls, now-playing and the live waveform arrive in
            Phase 6 PR 2; the log is here from PR 1 because it is what makes a half-built shell
            debuggable.
        -->
        <ui:Card Grid.Row="1" Margin="{StaticResource OffstreamStackGap}">
            <ListBox x:Name="LogList"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="{StaticResource OffstreamMonoFontFamily}"
                     FontSize="{StaticResource OffstreamMonoFontSize}"
                     ItemsSource="{Binding LogLines, Mode=OneWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </ui:Card>

        <ui:Button Grid.Row="2"
                   HorizontalAlignment="Left"
                   Command="{Binding ClearLogCommand}"
                   Content="{x:Static res:Strings.RecordClearLog}"
                   Icon="{ui:SymbolIcon Delete24}" />
    </Grid>

</Page>
