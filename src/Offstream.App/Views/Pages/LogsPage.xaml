<UserControl x:Class="Offstream.App.Views.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Offstream.App.Resources"
             xmlns:serilog="clr-namespace:Serilog.Events;assembly=Serilog"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Offstream.App.ViewModels">

    <UserControl.Resources>
        <!--
            One line of the activity log. Level is carried on the entry rather than parsed back
            out of the text, so a warning is a colour and not a substring match.
        -->
        <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type vm:LogEntry}">
            <TextBlock Text="{Binding Text, Mode=OneTime}" TextWrapping="NoWrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="{x:Static serilog:LogEventLevel.Warning}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="{x:Static serilog:LogEventLevel.Error}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level, Mode=OneTime}" Value="{x:Static serilog:LogEventLevel.Fatal}">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        The activity log, on a tab of its own.

        It has been three things on the Record page: the whole page, then a fixed-height box, then
        a collapsed expander — each one a different answer to the same question, which is that a
        log wants either all the room or none of it and a shared page can offer neither. A tab
        gives it the whole surface when it is asked for and none of it when it is not, and the
        Record page gets to be about the recording.

        The page is a second view onto RecordViewModel rather than a ViewModel of its own: the log
        lines, the filter, and both buttons are already there, subscribed to the sink since
        startup. A second ViewModel would mean a second subscription and two copies of the same
        history diverging by whichever one was constructed first.
    -->
    <Border Padding="12" Style="{StaticResource OffstreamCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0"
                                VerticalAlignment="Center"
                                Content="{x:Static res:Strings.RecordActivitySection}"
                                Style="{StaticResource OffstreamGroupHeaderStyle}" />

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <ComboBox Width="150"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              AutomationProperties.AutomationId="RecordLogFilter"
                              AutomationProperties.Name="{x:Static res:Strings.RecordFilterLabel}"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding FilterOptions, Mode=OneTime}"
                              SelectedValue="{Binding Filter, Mode=TwoWay}"
                              SelectedValuePath="Value" />

                    <ui:Button Margin="0,0,8,0"
                               AutomationProperties.AutomationId="RecordCopyLogButton"
                               Command="{Binding CopyLogCommand}"
                               Content="{x:Static res:Strings.RecordCopyLog}" />
                    <ui:Button AutomationProperties.AutomationId="RecordClearLogButton"
                               Command="{Binding ClearLogCommand}"
                               Content="{x:Static res:Strings.RecordClearLog}" />
                </StackPanel>
            </Grid>

            <ListBox x:Name="LogList"
                     Grid.Row="1"
                     AutomationProperties.AutomationId="RecordLogList"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="{StaticResource OffstreamMonoFontFamily}"
                     FontSize="{StaticResource OffstreamMonoFontSize}"
                     ItemTemplate="{StaticResource LogEntryTemplate}"
                     ItemsSource="{Binding LogLines, Mode=OneWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" />
        </Grid>
    </Border>

</UserControl>
