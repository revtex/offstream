<UserControl x:Class="Offstream.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Offstream.App.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        Three sections in one card, in the order a recording passes through them: where the file
        goes, how it is captured, and where its details come from.

        Two columns of fields inside each section, with every label directly above its own control.
        The first build laid one field per line with the label hard left and the control hard
        right, which at this window width put six hundred empty pixels between a setting's name and
        its value — unreadable, and the source of nearly all the wasted space on the page. Pairing
        vertically and running two abreast fixes both at once.

        There is no OK button. Every field validates as it is typed and saves itself once it is
        valid (see SettingsDocument), so a confirm step would only add a way to lose an edit.
        Text fields commit on focus loss rather than per keystroke: saving "1" on the way to
        "120" would write a setting the user never chose.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!-- One field: a label over its control, with room under it for whatever comes next. -->
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            A refused save is reported where the settings are, not in a dialog. It survives
            until the next successful write, because the file being unwritable is a state and
            not an event.
        -->
        <ui:InfoBar Grid.Row="0"
                    Margin="0,0,0,12"
                    AutomationProperties.AutomationId="SettingsSaveProblem"
                    IsClosable="False"
                    IsOpen="{Binding HasSaveProblem, Mode=OneWay}"
                    Message="{Binding SaveProblem, Mode=OneWay}"
                    Severity="Error" />

        <Border Grid.Row="1"
                Padding="24,20,24,8"
                Style="{StaticResource OffstreamCardStyle}">
            <StackPanel>

                <!--  Output  -->

                <ContentControl Content="{x:Static res:Strings.SettingsOutputSection}" Style="{StaticResource OffstreamGroupHeaderStyle}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.SettingsOutputPathLabel}" />
                        <DockPanel>
                            <ui:Button Margin="8,0,0,0"
                                       AutomationProperties.AutomationId="SettingsBrowseButton"
                                       Command="{Binding BrowseCommand}"
                                       Content="{x:Static res:Strings.SettingsBrowse}"
                                       DockPanel.Dock="Right"
                                       Icon="{ui:SymbolIcon FolderOpen24}" />
                            <ui:TextBox x:Name="OutputPathBox"
                                        AutomationProperties.AutomationId="SettingsOutputPath"
                                        AutomationProperties.Name="{x:Static res:Strings.SettingsOutputPathLabel}"
                                        Text="{Binding OutputPath, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=OutputPathBox, Path=(Validation.Errors)/ErrorContent}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.SettingsFormatLabel}" />
                        <ComboBox AutomationProperties.AutomationId="SettingsFormat"
                                  AutomationProperties.Name="{x:Static res:Strings.SettingsFormatLabel}"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding Formats, Mode=OneTime}"
                                  SelectedValue="{Binding Format, Mode=TwoWay}"
                                  SelectedValuePath="Value" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.SettingsBitrateLabel}" />
                        <ComboBox AutomationProperties.AutomationId="SettingsBitrate"
                                  AutomationProperties.Name="{x:Static res:Strings.SettingsBitrateLabel}"
                                  IsEnabled="{Binding SupportsBitrate, Mode=OneWay}"
                                  ItemStringFormat="{x:Static res:Strings.SettingsBitrateItem}"
                                  ItemsSource="{Binding Bitrates, Mode=OneWay}"
                                  SelectedValue="{Binding BitrateKbps, Mode=TwoWay}" />

                        <!--
                            Shown only for the formats that have no bitrate to set, so the
                            disabled control above explains itself instead of looking broken.
                        -->
                        <TextBlock Text="{x:Static res:Strings.SettingsBitrateNotApplicable}">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource OffstreamHintStyle}" TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SupportsBitrate, Mode=OneWay}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!--  Recording  -->

                <ContentControl Content="{x:Static res:Strings.SettingsRecordingSection}" Style="{StaticResource OffstreamGroupHeaderStyle}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.SettingsDeviceLabel}" />
                        <DockPanel>
                            <ui:Button Margin="8,0,0,0"
                                       AutomationProperties.AutomationId="SettingsDeviceRefreshButton"
                                       Command="{Binding RefreshDevicesCommand}"
                                       Content="{x:Static res:Strings.SettingsDeviceRefresh}"
                                       DockPanel.Dock="Right"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}" />
                            <ComboBox AutomationProperties.AutomationId="SettingsDevice"
                                      AutomationProperties.Name="{x:Static res:Strings.SettingsDeviceLabel}"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding Devices, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" />
                        </DockPanel>

                        <!--
                            Recording a normal output device records the whole machine, so whether
                            a virtual cable is present decides what a recording can contain. Stated
                            here, next to the choice it affects, and both ways round: a user who
                            has the cable and is looking for it in the list is told it is there.

                            The link goes to the vendor. Offstream carries no installer for it —
                            see Offstream.Core.Audio.VirtualCable for the licence that decides that.
                        -->
                        <TextBlock AutomationProperties.AutomationId="SettingsVirtualCableStatus"
                                   Style="{StaticResource OffstreamHintStyle}"
                                   Text="{Binding VirtualCableStatus, Mode=OneWay}" />

                        <ui:HyperlinkButton Margin="0,2,0,0"
                                            Padding="0,2"
                                            AutomationProperties.AutomationId="SettingsVirtualCableLink"
                                            Content="{x:Static res:Strings.SettingsVirtualCableGet}"
                                            NavigateUri="{Binding VirtualCableUrl, Mode=OneTime}"
                                            Visibility="{Binding IsVirtualCableMissing, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.SettingsMinimumLengthLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox x:Name="MinimumLengthBox"
                                        Width="110"
                                        AutomationProperties.AutomationId="SettingsMinimumLength"
                                        AutomationProperties.Name="{x:Static res:Strings.SettingsMinimumLengthLabel}"
                                        Text="{Binding MinimumLengthSeconds, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}" />

                            <!--  Sized to the number it holds. A full-width box for "30" reads as a field expecting a sentence.  -->
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource OffstreamIdleBrush}"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Text="{x:Static res:Strings.SettingsSecondsUnit}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=MinimumLengthBox, Path=(Validation.Errors)/ErrorContent}" />
                    </StackPanel>
                </Grid>

                <!--  Track details  -->

                <ContentControl Content="{x:Static res:Strings.SettingsMetadataSection}" Style="{StaticResource OffstreamGroupHeaderStyle}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.SettingsProviderLabel}" />
                        <ComboBox AutomationProperties.AutomationId="SettingsProvider"
                                  AutomationProperties.Name="{x:Static res:Strings.SettingsProviderLabel}"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding Providers, Mode=OneTime}"
                                  SelectedValue="{Binding Provider, Mode=TwoWay}"
                                  SelectedValuePath="Value" />

                        <!--
                            What the selection above actually changes. The dropdown named three
                            providers and said nothing about how they differ, so the only way to
                            find out was to record something and run ffprobe over it.
                        -->
                        <TextBlock AutomationProperties.AutomationId="SettingsProviderSummary"
                                   Style="{StaticResource OffstreamHintStyle}"
                                   Text="{Binding ProviderSummary, Mode=OneWay}" />
                    </StackPanel>

                    <!--
                        The two credential blocks share one cell because only one is ever shown:
                        each provider's field is absent for the other rather than disabled, since
                        it is not a setting they have.
                    -->
                    <Grid Grid.Column="2">
                        <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsLastFmProvider, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.SettingsLastFmApiKeyLabel}" />
                            <ui:TextBox x:Name="LastFmApiKeyBox"
                                        AutomationProperties.AutomationId="SettingsLastFmApiKey"
                                        AutomationProperties.Name="{x:Static res:Strings.SettingsLastFmApiKeyLabel}"
                                        Text="{Binding LastFmApiKey, Mode=TwoWay}" />

                            <!--
                                A warning, not a validation error: Last.fm is the default provider,
                                so a fresh install lands here untouched, and an error would block
                                saving every unrelated setting until a key was pasted in.
                            -->
                            <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}"
                                       Text="{x:Static res:Strings.SettingsLastFmApiKeyRequired}"
                                       Visibility="{Binding NeedsLastFmApiKey, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

                            <TextBlock Style="{StaticResource OffstreamHintStyle}" Text="{x:Static res:Strings.SettingsLastFmApiKeyHint}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsSpotifyProvider, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.SettingsClientIdLabel}" />
                            <ui:TextBox x:Name="ClientIdBox"
                                        AutomationProperties.AutomationId="SettingsClientId"
                                        AutomationProperties.Name="{x:Static res:Strings.SettingsClientIdLabel}"
                                        Text="{Binding SpotifyClientId, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=ClientIdBox, Path=(Validation.Errors)/ErrorContent}" />
                            <TextBlock Style="{StaticResource OffstreamHintStyle}" Text="{x:Static res:Strings.SettingsClientIdHint}" />

                            <!--
                                The Client ID identifies the app; it grants nothing. This button is
                                what actually produces the token a recording presents, which is why
                                the status line beside it says plainly whether one exists.
                            -->
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <ui:Button AutomationProperties.AutomationId="SettingsSpotifySignIn"
                                           Command="{Binding SignInToSpotifyCommand, Mode=OneTime}"
                                           Content="{x:Static res:Strings.SettingsSpotifySignIn}" />

                                <TextBlock Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource OffstreamHintStyle}"
                                           Text="{Binding SpotifyAccountStatus, Mode=OneWay}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource OffstreamHintStyle}"
                                       Text="{x:Static res:Strings.SettingsSpotifySigningIn}"
                                       Visibility="{Binding IsSigningInToSpotify, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!--  Where the file is, so it can be found, backed up, or deleted to start over.  -->
        <TextBlock Grid.Row="2"
                   Margin="4,10,0,0"
                   Style="{StaticResource OffstreamHintStyle}"
                   Text="{Binding SettingsPath, Mode=OneTime, StringFormat={x:Static res:Strings.SettingsStoredAt}}" />
    </Grid>

</UserControl>
