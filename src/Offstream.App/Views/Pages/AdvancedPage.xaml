<UserControl x:Class="Offstream.App.Views.Pages.AdvancedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Offstream.App.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Offstream.App.ViewModels">

    <!--
        Everything a recording needs that is not "where does it go and what does it sound like":
        naming, what counts as a track, what ends up in the tags, and the two application settings
        with nowhere else to live.

        Laid out by what each section actually needs rather than by splitting the count in half.
        File names goes across the top because its content is wide — a path template, and a
        rendered path under it — and folding that into a half-width column wrapped both onto three
        lines. Detection and Application take a column each below it, because their content is a
        list of short rows, which is the shape a narrow column suits.

        Inside a column the grammar matches Settings — label directly above its control for
        anything with a value, label and switch on one line for anything that is only on or off,
        since a switch is its own answer and needs no field under it.

        Same contract as the Settings page: inline validation, no OK button.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!--
            The label half of a switch row.

            The switches sit at the card's right edge and the labels run from the left, so a row
            reads as one line: name on one side, answer on the other. An earlier version pinned
            the label column to a fixed width to keep the switch close to its label; that put the
            switches in a column of their own somewhere in the middle of the card and forced every
            label longer than the pin onto two and three lines, which is the thing that actually
            made the section hard to read.
        -->
        <Style x:Key="SwitchLabel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,20,12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            One line each, for the label and for the sentence under it.

            A switch row is a name and a yes/no, and a name that takes three lines to say stops
            looking like one. The column is free to grow now that nothing pins it, so there is
            room for these at any sensible window size; the ellipsis and tooltip are the floor
            under a window dragged narrower than the longest label.
        -->
        <Style x:Key="SwitchRowLabel"
               BasedOn="{StaticResource OffstreamFieldLabelStyle}"
               TargetType="TextBlock">
            <Setter Property="Margin" Value="0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>

        <Style x:Key="Switch"
               BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}"
               TargetType="ui:ToggleSwitch">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            One token and what it renders to. The token itself is monospaced because it is typed
            verbatim into the box above, braces and all.
        -->
        <DataTemplate x:Key="TemplateTokenTemplate" DataType="{x:Type vm:TemplateToken}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="TokenName" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="0,0,12,0"
                           FontFamily="{StaticResource OffstreamMonoFontFamily}"
                           FontSize="{StaticResource OffstreamMonoFontSize}"
                           Text="{Binding Token, Mode=OneTime}" />
                <TextBlock Grid.Column="1"
                           Foreground="{StaticResource OffstreamIdleBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{Binding Description, Mode=OneTime}"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:InfoBar Grid.Row="0"
                    Margin="0,0,0,12"
                    AutomationProperties.AutomationId="AdvancedSaveProblem"
                    IsClosable="False"
                    IsOpen="{Binding HasSaveProblem, Mode=OneWay}"
                    Message="{Binding SaveProblem, Mode=OneWay}"
                    Severity="Error" />

        <!--  What the file is called. Across the top, because everything in it is a long string.  -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="20,16,20,4"
                Style="{StaticResource OffstreamCardStyle}">
            <StackPanel>
                <ContentControl Content="{x:Static res:Strings.AdvancedNamingSection}" Style="{StaticResource OffstreamGroupHeaderStyle}" />

                <!--
                    One column. The card used to carry a second, Auto-width one holding the
                    existing-file dropdown and the switch beside it — but what to do about a file
                    that is already there is a recording rule, not a naming one, and both have
                    moved to the card that governs recording. What is left is a template, what it
                    renders to, and the counter that template may use, all of which want the line.
                -->
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.AdvancedTemplateLabel}" />

                    <DockPanel>
                        <!--
                            The token reference is a flyout off this button rather than an
                            expander in the flow. Ten rows of reference text pushed everything
                            below it off the page the moment it opened, which on a page that
                            promises not to scroll is not an option — and a reference is
                            something you consult while typing, so it belongs over the layout
                            rather than inside it.
                        -->
                        <ToggleButton x:Name="TokenReferenceButton"
                                      Margin="8,0,0,0"
                                      AutomationProperties.AutomationId="AdvancedTemplateTokens"
                                      AutomationProperties.Name="{x:Static res:Strings.AdvancedTemplateTokens}"
                                      DockPanel.Dock="Right"
                                      IsChecked="{Binding IsTokenReferenceOpen, Mode=TwoWay}"
                                      ToolTip="{x:Static res:Strings.AdvancedTemplateTokens}">
                            <ui:SymbolIcon Symbol="QuestionCircle24" />
                        </ToggleButton>

                        <!--
                            The one field on either page that commits per keystroke: the
                            preview under it is the whole point, and a preview that waits for
                            focus loss is a preview of the previous template.
                        -->
                        <ui:TextBox x:Name="TemplateBox"
                                    AutomationProperties.AutomationId="AdvancedTemplate"
                                    AutomationProperties.Name="{x:Static res:Strings.AdvancedTemplateLabel}"
                                    FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                    Text="{Binding Template, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=TemplateBox, Path=(Validation.Errors)/ErrorContent}" />

                    <!--
                        Rendered by the recorder's own naming code, so what is shown here is
                        the path that would be written, length budgeting and all.

                        In a recessed well rather than as loose text: it is the one thing in
                        this card that is output rather than input, and until it had a surface
                        of its own it read as a caption under the box instead of as the answer
                        the box produces.

                        One line, with its label inside it. The page has to fit the window's
                        minimum height without scrolling, and a label on its own line above a
                        two-line well was enough on its own to push the bottom card off the
                        end. A rendered path is one line in every realistic case, and the
                        ellipsis and tooltip carry the ones that are not.
                    -->
                    <Border Margin="0,6,0,0"
                            Padding="10,5"
                            Background="{StaticResource OffstreamWellBrush}"
                            BorderBrush="{StaticResource OffstreamSurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <DockPanel>
                            <TextBlock Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"
                                       Foreground="{StaticResource OffstreamIdleBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Static res:Strings.AdvancedPreviewLabel}" />

                            <TextBlock VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="AdvancedTemplatePreview"
                                       FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                       FontSize="{StaticResource OffstreamMonoFontSize}"
                                       Text="{Binding TemplatePreview, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       ToolTip="{Binding TemplatePreview, Mode=OneWay}" />
                        </DockPanel>
                    </Border>

                    <!--
                        A caption, because two unlabelled buttons under a text box read as
                        actions on what is in it — "reset", "apply" — rather than as layouts to
                        start from. It docks left instead of sitting on a line of its own: this
                        card is at the top of a page that has to fit the window's minimum height,
                        and a row spent on one word is a row the bottom card loses.

                        A WrapPanel, not a horizontal StackPanel, because five buttons at the
                        window's narrowest are close to the card's width and a StackPanel would
                        clip the last one silently rather than move it down.

                        Each button's tooltip is the path its layout produces, rendered by the
                        recorder's own naming code — a preset is only ever picked for its
                        outcome, and the label has room for a name but not for a path. The same
                        sentence is the button's HelpText: unlike the settings elsewhere on this
                        page, what a screen reader needs here is not a description of the control
                        but the example itself.
                    -->
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"
                                   Foreground="{StaticResource OffstreamIdleBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="{x:Static res:Strings.AdvancedTemplatePresetsLabel}" />

                        <ItemsControl AutomationProperties.AutomationId="AdvancedTemplatePresets" ItemsSource="{Binding Presets, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TemplatePreset}">
                                    <ui:Button Margin="0,0,8,4"
                                               AutomationProperties.AutomationId="{Binding AutomationId, Mode=OneTime}"
                                               AutomationProperties.HelpText="{Binding Example, Mode=OneTime}"
                                               AutomationProperties.Name="{Binding Name, Mode=OneTime}"
                                               Command="{Binding DataContext.UsePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding Mode=OneTime}"
                                               Content="{Binding Name, Mode=OneTime}"
                                               ToolTip="{Binding Example, Mode=OneTime}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </StackPanel>

                <!--
                    Only shown when the template actually uses {count}. A "next number" field
                    beside a template that never numbers anything is a setting with no effect,
                    and the row it costs is a row the page does not have to spare.
                -->
                <StackPanel Style="{StaticResource Field}" Visibility="{Binding UsesCounter, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.AdvancedCounterLabel}" />
                    <ui:TextBox x:Name="CounterBox"
                                Width="150"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="AdvancedFileCounter"
                                AutomationProperties.Name="{x:Static res:Strings.AdvancedCounterLabel}"
                                Text="{Binding FileCounter, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}" />
                    <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=CounterBox, Path=(Validation.Errors)/ErrorContent}" />
                </StackPanel>

                <!--
                    StaysOpen false so a click anywhere else dismisses it, which writes false
                    back through the same property the button is bound to and pops the button
                    out with it.
                -->
                <Popup AllowsTransparency="True"
                       HorizontalOffset="-8"
                       IsOpen="{Binding IsTokenReferenceOpen, Mode=TwoWay}"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=TokenReferenceButton}"
                       PopupAnimation="Fade"
                       StaysOpen="False"
                       VerticalOffset="6">
                    <Border MaxWidth="420"
                            Padding="16"
                            Style="{StaticResource OffstreamCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{x:Static res:Strings.AdvancedTemplateTokens}" Style="{StaticResource OffstreamGroupHeaderStyle}" />
                            <ItemsControl AutomationProperties.AutomationId="AdvancedTokenList"
                                          Grid.IsSharedSizeScope="True"
                                          ItemTemplate="{StaticResource TemplateTokenTemplate}"
                                          ItemsSource="{Binding Tokens, Mode=OneTime}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  What counts as a track, and what ends up in its tags.  -->
            <Border Grid.Column="0"
                    Padding="20,16,20,4"
                    Style="{StaticResource OffstreamCardStyle}">
                <StackPanel>
                    <ContentControl Content="{x:Static res:Strings.AdvancedRecordingSection}" Style="{StaticResource OffstreamGroupHeaderStyle}" />

                    <!--
                        One list where there were three switches.

                        "Only recognisable tracks", "record everything" and "include ads" were
                        three booleans over three outcomes, and one of their four combinations was
                        indistinguishable from another — so two of the switches did nothing unless
                        a third allowed it, and the card had to grey controls out to explain a
                        hierarchy that was never visible in the first place. One question with one
                        answer is a list, and a list needs no explaining, no indentation and no
                        disabled states. It is also two rows shorter, which this page needs.
                    -->
                    <StackPanel Style="{StaticResource Field}" ToolTip="{x:Static res:Strings.AdvancedSelectionHint}">
                        <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.AdvancedSelectionLabel}" />
                        <ComboBox AutomationProperties.AutomationId="AdvancedRecordSelection"
                                  AutomationProperties.HelpText="{x:Static res:Strings.AdvancedSelectionHint}"
                                  AutomationProperties.Name="{x:Static res:Strings.AdvancedSelectionLabel}"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding Selections, Mode=OneTime}"
                                  SelectedValue="{Binding RecordSelection, Mode=TwoWay}"
                                  SelectedValuePath="Value" />
                    </StackPanel>

                    <!--
                        Moved here from the file-names card, where it never belonged: what to do
                        about a file that already exists is a rule about recording, not about what
                        recordings are called.

                        "Also tell Spotify to move on" used to be a switch beside this dropdown,
                        greyed out under two of the three policies because both of those write the
                        file again and leave it nothing to move past. So the switch was really a
                        second half of this answer, and it is now the fourth line of it — which
                        also gives the row its full width back, where the switch's label clipped.
                    -->
                    <StackPanel Style="{StaticResource Field}" ToolTip="{x:Static res:Strings.AdvancedExistingHint}">
                        <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.AdvancedExistingLabel}" />
                        <ComboBox AutomationProperties.AutomationId="AdvancedExistingFilePolicy"
                                  AutomationProperties.HelpText="{x:Static res:Strings.AdvancedExistingHint}"
                                  AutomationProperties.Name="{x:Static res:Strings.AdvancedExistingLabel}"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding Policies, Mode=OneTime}"
                                  SelectedValue="{Binding ExistingFilePolicy, Mode=TwoWay}"
                                  SelectedValuePath="Value" />
                    </StackPanel>

                    <!--
                        The timer keeps the switch-row shape the rest of the page uses: name on
                        the left, answer on the right, and the duration in front of the switch so
                        the switch stays in the column every other switch is in. The value is part
                        of the setting's name — stop recording after *this long* — and the switch
                        is still the answer, in the place answers live.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Style="{StaticResource SwitchLabel}">
                            <TextBlock Style="{StaticResource SwitchRowLabel}" Text="{x:Static res:Strings.AdvancedTimerEnabled}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:TextBox x:Name="TimerBox"
                                        Width="120"
                                        Margin="0,0,12,12"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="AdvancedTimer"
                                        AutomationProperties.Name="{x:Static res:Strings.AdvancedTimerEnabled}"
                                        FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                        IsEnabled="{Binding IsTimerEnabled, Mode=OneWay}"
                                        Text="{Binding Timer, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}" />

                            <ui:ToggleSwitch AutomationProperties.AutomationId="AdvancedTimerEnabled"
                                             AutomationProperties.Name="{x:Static res:Strings.AdvancedTimerEnabled}"
                                             IsChecked="{Binding IsTimerEnabled, Mode=TwoWay}"
                                             Style="{StaticResource Switch}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=TimerBox, Path=(Validation.Errors)/ErrorContent}" />

                    <ContentControl Content="{x:Static res:Strings.AdvancedTagsSection}" Style="{StaticResource OffstreamGroupHeaderStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!--  The label, taking whatever the switch column does not.  -->
                            <ColumnDefinition Width="*" />

                            <!--
                                Auto, so the column's right edge is the grid's right edge and a
                                switch aligned right inside it lands on the card's margin. Every
                                row in the section shares the column, so they line up whatever
                                their labels do.
                            -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Style="{StaticResource SwitchLabel}"
                                    ToolTip="{x:Static res:Strings.AdvancedWriteCounterHint}">
                            <TextBlock Style="{StaticResource SwitchRowLabel}" Text="{x:Static res:Strings.AdvancedWriteCounter}" />
                        </StackPanel>

                        <ui:ToggleSwitch Grid.Column="1"
                                         AutomationProperties.AutomationId="AdvancedWriteCounter"
                                         AutomationProperties.HelpText="{x:Static res:Strings.AdvancedWriteCounterHint}"
                                         AutomationProperties.Name="{x:Static res:Strings.AdvancedWriteCounter}"
                                         IsChecked="{Binding WriteCounterToTrackNumber, Mode=TwoWay}"
                                         Style="{StaticResource Switch}"
                                         ToolTip="{x:Static res:Strings.AdvancedWriteCounterHint}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  How the app itself behaves.  -->
            <Border Grid.Column="2"
                    Padding="20,16,20,4"
                    Style="{StaticResource OffstreamCardStyle}">
                <StackPanel>
                    <!--
                        The section header, with the licence behind a link on the same line.

                        On the header rather than under the last setting, and the reason is
                        structural: this card already reaches the bottom of the window at its
                        minimum size, and the shell's minimum size is a promise that no setting is
                        ever out of reach without scrolling. A control added below the ffmpeg path
                        broke that promise the first time it was tried — the version line and its
                        button were clipped off the bottom edge. The header line is the one place
                        in the card with room that costs nothing, and the rule simply runs up to
                        the link instead of across.

                        The running version is not repeated here; it is the first thing in the
                        window the link opens.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentControl Content="{x:Static res:Strings.AdvancedAppSection}" Style="{StaticResource OffstreamGroupHeaderStyle}" />

                        <ui:HyperlinkButton Grid.Column="1"
                                            Margin="12,0,0,8"
                                            Padding="4,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="AdvancedNotices"
                                            Click="OnShowNotices"
                                            Content="{x:Static res:Strings.AdvancedNoticesButton}"
                                            FontSize="12" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!--  The label, taking whatever the switch column does not.  -->
                            <ColumnDefinition Width="*" />

                            <!--
                                Auto, so the column's right edge is the grid's right edge and a
                                switch aligned right inside it lands on the card's margin. Every
                                row in the section shares the column, so they line up whatever
                                their labels do.
                            -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Style="{StaticResource SwitchLabel}">
                            <TextBlock Style="{StaticResource SwitchRowLabel}" Text="{x:Static res:Strings.AdvancedMinimizeToTray}" />
                        </StackPanel>

                        <ui:ToggleSwitch Grid.Column="1"
                                         AutomationProperties.AutomationId="AdvancedMinimizeToTray"
                                         AutomationProperties.Name="{x:Static res:Strings.AdvancedMinimizeToTray}"
                                         IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                         Style="{StaticResource Switch}" />
                    </Grid>

                    <!--
                        Capped rather than stretched. Neither of these is read left to right — a
                        language is one word and an ffmpeg path is scanned for its tail — so a box
                        that grows with the window only puts more empty field behind the value.
                    -->
                    <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.AdvancedLanguageLabel}" />
                            <ComboBox AutomationProperties.AutomationId="AdvancedLanguage"
                                      AutomationProperties.HelpText="{x:Static res:Strings.AdvancedLanguageRestart}"
                                      AutomationProperties.Name="{x:Static res:Strings.AdvancedLanguageLabel}"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding Languages, Mode=OneTime}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                      ToolTip="{x:Static res:Strings.AdvancedLanguageRestart}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.AdvancedFfmpegLabel}" />
                            <ui:TextBox x:Name="FfmpegBox"
                                        AutomationProperties.AutomationId="AdvancedFfmpegPath"
                                        AutomationProperties.HelpText="{x:Static res:Strings.AdvancedFfmpegHint}"
                                        AutomationProperties.Name="{x:Static res:Strings.AdvancedFfmpegLabel}"
                                        Text="{Binding FfmpegPath, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                                        ToolTip="{x:Static res:Strings.AdvancedFfmpegHint}" />
                            <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=FfmpegBox, Path=(Validation.Errors)/ErrorContent}" />

                            <!--  Which ffmpeg an empty box resolves to, since that is the usual case.  -->
                            <TextBlock Style="{StaticResource OffstreamHintStyle}"
                                       Text="{Binding FfmpegStatus, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       ToolTip="{Binding FfmpegStatus, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</UserControl>
