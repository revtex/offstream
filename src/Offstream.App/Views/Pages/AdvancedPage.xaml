<UserControl x:Class="Offstream.App.Views.Pages.AdvancedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Offstream.App.Resources"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Offstream.App.ViewModels">

    <!--
        Everything a recording needs that is not "where does it go and what does it sound like":
        naming, what counts as a track, what ends up in the tags, and the two application settings
        with nowhere else to live.

        Two columns, at the user's direction, and the split is by subject rather than by length:
        the left column is the file that gets written, the right is what the app watches for and
        how the app itself behaves. Thirteen settings do not fit one column at the window's minimum
        height, and this page makes the same no-scroll promise the Settings page does.

        Inside a column the grammar matches Settings — label directly above its control for
        anything with a value, label and switch on one line for anything that is only on or off,
        since a switch is its own answer and needs no field under it.

        Same contract as the Settings page: inline validation, no OK button.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="SwitchRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!--
            One token and what it renders to. The token itself is monospaced because it is typed
            verbatim into the box above, braces and all.
        -->
        <DataTemplate x:Key="TemplateTokenTemplate" DataType="{x:Type vm:TemplateToken}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="TokenName" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="0,0,12,0"
                           FontFamily="{StaticResource OffstreamMonoFontFamily}"
                           FontSize="{StaticResource OffstreamMonoFontSize}"
                           Text="{Binding Token, Mode=OneTime}" />
                <TextBlock Grid.Column="1"
                           Foreground="{StaticResource OffstreamIdleBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{Binding Description, Mode=OneTime}"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:InfoBar Grid.Row="0"
                    Margin="0,0,0,12"
                    AutomationProperties.AutomationId="AdvancedSaveProblem"
                    IsClosable="False"
                    IsOpen="{Binding HasSaveProblem, Mode=OneWay}"
                    Message="{Binding SaveProblem, Mode=OneWay}"
                    Severity="Error" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  The file that gets written: what it is called, and what goes in its tags.  -->
            <Border Grid.Column="0"
                    Padding="24,20,24,8"
                    VerticalAlignment="Top"
                    Style="{StaticResource OffstreamCardStyle}">
                <StackPanel>
                    <ContentControl Content="{x:Static res:Strings.AdvancedNamingSection}" Style="{StaticResource OffstreamGroupHeaderStyle}" />

                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.AdvancedTemplateLabel}" />

                        <DockPanel>
                            <!--
                                The token reference is a flyout off this button rather than an
                                expander in the flow. Ten rows of reference text pushed everything
                                below it off the page the moment it opened, which on a page that
                                promises not to scroll is not an option — and a reference is
                                something you consult while typing, so it belongs over the layout
                                rather than inside it.
                            -->
                            <ToggleButton x:Name="TokenReferenceButton"
                                          Margin="8,0,0,0"
                                          AutomationProperties.AutomationId="AdvancedTemplateTokens"
                                          AutomationProperties.Name="{x:Static res:Strings.AdvancedTemplateTokens}"
                                          DockPanel.Dock="Right"
                                          IsChecked="{Binding IsTokenReferenceOpen, Mode=TwoWay}"
                                          ToolTip="{x:Static res:Strings.AdvancedTemplateTokens}">
                                <ui:SymbolIcon Symbol="QuestionCircle24" />
                            </ToggleButton>

                            <!--
                                The one field on either page that commits per keystroke: the
                                preview below it is the whole point, and a preview that waits for
                                focus loss is a preview of the previous template.
                            -->
                            <ui:TextBox x:Name="TemplateBox"
                                        AutomationProperties.AutomationId="AdvancedTemplate"
                                        AutomationProperties.Name="{x:Static res:Strings.AdvancedTemplateLabel}"
                                        FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                        Text="{Binding Template, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=TemplateBox, Path=(Validation.Errors)/ErrorContent}" />

                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <ui:Button AutomationProperties.AutomationId="AdvancedTemplateDefaultButton"
                                       Command="{Binding ResetTemplateCommand}"
                                       Content="{x:Static res:Strings.AdvancedTemplateDefault}" />
                            <ui:Button Margin="8,0,0,0"
                                       AutomationProperties.AutomationId="AdvancedTemplateGroupedButton"
                                       Command="{Binding UseGroupedTemplateCommand}"
                                       Content="{x:Static res:Strings.AdvancedTemplateGrouped}" />
                        </StackPanel>
                    </StackPanel>

                    <!--
                        StaysOpen false so a click anywhere else dismisses it, which writes false
                        back through the same property the button is bound to and pops the button
                        out with it.
                    -->
                    <Popup AllowsTransparency="True"
                           HorizontalOffset="-8"
                           IsOpen="{Binding IsTokenReferenceOpen, Mode=TwoWay}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=TokenReferenceButton}"
                           PopupAnimation="Fade"
                           StaysOpen="False"
                           VerticalOffset="6">
                        <Border MaxWidth="420"
                                Padding="16"
                                Style="{StaticResource OffstreamCardStyle}">
                            <StackPanel>
                                <ContentControl Content="{x:Static res:Strings.AdvancedTemplateTokens}" Style="{StaticResource OffstreamGroupHeaderStyle}" />
                                <ItemsControl AutomationProperties.AutomationId="AdvancedTokenList"
                                              Grid.IsSharedSizeScope="True"
                                              ItemTemplate="{StaticResource TemplateTokenTemplate}"
                                              ItemsSource="{Binding Tokens, Mode=OneTime}" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.AdvancedPreviewLabel}" />

                        <!--
                            Rendered by the recorder's own naming code, so what is shown here is
                            the path that would be written — including the length budgeting.
                        -->
                        <TextBlock AutomationProperties.AutomationId="AdvancedTemplatePreview"
                                   FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                   FontSize="{StaticResource OffstreamMonoFontSize}"
                                   Text="{Binding TemplatePreview, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />

                            <!--
                                Auto, not star. The counter beside it is only shown for templates
                                that use {count}, and a star column would hold half the card empty
                                for every template that does not — which is what made the policy
                                label wrap over two lines with nothing beside it.
                            -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.AdvancedExistingLabel}" />
                            <ComboBox AutomationProperties.AutomationId="AdvancedExistingFilePolicy"
                                      AutomationProperties.Name="{x:Static res:Strings.AdvancedExistingLabel}"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding Policies, Mode=OneTime}"
                                      SelectedValue="{Binding ExistingFilePolicy, Mode=TwoWay}"
                                      SelectedValuePath="Value" />
                        </StackPanel>

                        <!--
                            Only shown when the template actually uses {count}. A "next number"
                            field beside a template that never numbers anything is a setting with
                            no effect.
                        -->
                        <StackPanel Grid.Column="1"
                                    Width="150"
                                    Margin="20,0,0,14"
                                    Visibility="{Binding UsesCounter, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.AdvancedCounterLabel}" />
                            <ui:TextBox x:Name="CounterBox"
                                        AutomationProperties.AutomationId="AdvancedFileCounter"
                                        AutomationProperties.Name="{x:Static res:Strings.AdvancedCounterLabel}"
                                        Text="{Binding FileCounter, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=CounterBox, Path=(Validation.Errors)/ErrorContent}" />
                            <TextBlock Style="{StaticResource OffstreamHintStyle}" Text="{x:Static res:Strings.AdvancedCounterHint}" />
                        </StackPanel>
                    </Grid>

                    <ContentControl Content="{x:Static res:Strings.AdvancedTagsSection}" Style="{StaticResource OffstreamGroupHeaderStyle}" />

                    <DockPanel Style="{StaticResource SwitchRow}">
                        <ui:ToggleSwitch Margin="16,0,0,0"
                                         VerticalAlignment="Center"
                                         AutomationProperties.AutomationId="AdvancedWriteCounter"
                                         AutomationProperties.Name="{x:Static res:Strings.AdvancedWriteCounter}"
                                         DockPanel.Dock="Right"
                                         IsChecked="{Binding WriteCounterToTrackNumber, Mode=TwoWay}" />

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Margin="0"
                                       Style="{StaticResource OffstreamFieldLabelStyle}"
                                       Text="{x:Static res:Strings.AdvancedWriteCounter}" />
                            <TextBlock Style="{StaticResource OffstreamHintStyle}" Text="{x:Static res:Strings.AdvancedWriteCounterHint}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!--  What the app watches for, and how the app itself behaves.  -->
            <Border Grid.Column="2"
                    Padding="24,20,24,8"
                    VerticalAlignment="Top"
                    Style="{StaticResource OffstreamCardStyle}">
                <StackPanel>
                    <ContentControl Content="{x:Static res:Strings.AdvancedDetectionSection}" Style="{StaticResource OffstreamGroupHeaderStyle}" />

                    <DockPanel Style="{StaticResource SwitchRow}">
                        <ui:ToggleSwitch Margin="16,0,0,0"
                                         VerticalAlignment="Center"
                                         AutomationProperties.AutomationId="AdvancedMuteAds"
                                         AutomationProperties.Name="{x:Static res:Strings.AdvancedMuteAds}"
                                         DockPanel.Dock="Right"
                                         IsChecked="{Binding MuteAds, Mode=TwoWay}" />

                        <TextBlock Margin="0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource OffstreamFieldLabelStyle}"
                                   Text="{x:Static res:Strings.AdvancedMuteAds}" />
                    </DockPanel>

                    <DockPanel Style="{StaticResource SwitchRow}">
                        <ui:ToggleSwitch Margin="16,0,0,0"
                                         VerticalAlignment="Center"
                                         AutomationProperties.AutomationId="AdvancedRecordEverything"
                                         AutomationProperties.Name="{x:Static res:Strings.AdvancedRecordEverything}"
                                         DockPanel.Dock="Right"
                                         IsChecked="{Binding RecordEverything, Mode=TwoWay}" />

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Margin="0"
                                       Style="{StaticResource OffstreamFieldLabelStyle}"
                                       Text="{x:Static res:Strings.AdvancedRecordEverything}" />
                            <TextBlock Style="{StaticResource OffstreamHintStyle}" Text="{x:Static res:Strings.AdvancedRecordEverythingHint}" />
                        </StackPanel>
                    </DockPanel>

                    <!--
                        Disabled rather than hidden while track detection is on: an advertisement
                        has no artist and is never written as a file, and seeing the switch greyed
                        out under the one that governs it is the explanation.
                    -->
                    <DockPanel Style="{StaticResource SwitchRow}">
                        <ui:ToggleSwitch Margin="16,0,0,0"
                                         VerticalAlignment="Center"
                                         AutomationProperties.AutomationId="AdvancedRecordAds"
                                         AutomationProperties.Name="{x:Static res:Strings.AdvancedRecordAds}"
                                         DockPanel.Dock="Right"
                                         IsChecked="{Binding RecordAds, Mode=TwoWay}"
                                         IsEnabled="{Binding CanRecordAds, Mode=OneWay}" />

                        <TextBlock Margin="0"
                                   VerticalAlignment="Center"
                                   IsEnabled="{Binding CanRecordAds, Mode=OneWay}"
                                   Style="{StaticResource OffstreamFieldLabelStyle}"
                                   Text="{x:Static res:Strings.AdvancedRecordAds}" />
                    </DockPanel>

                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.AdvancedTimerEnabled}" />

                        <DockPanel>
                            <ui:ToggleSwitch Margin="0,0,12,0"
                                             VerticalAlignment="Center"
                                             AutomationProperties.AutomationId="AdvancedTimerEnabled"
                                             AutomationProperties.Name="{x:Static res:Strings.AdvancedTimerEnabled}"
                                             DockPanel.Dock="Left"
                                             IsChecked="{Binding IsTimerEnabled, Mode=TwoWay}" />
                            <ui:TextBox x:Name="TimerBox"
                                        Width="150"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="AdvancedTimer"
                                        AutomationProperties.Name="{x:Static res:Strings.AdvancedTimerEnabled}"
                                        FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                        IsEnabled="{Binding IsTimerEnabled, Mode=OneWay}"
                                        Text="{Binding Timer, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=TimerBox, Path=(Validation.Errors)/ErrorContent}" />
                    </StackPanel>

                    <ContentControl Content="{x:Static res:Strings.AdvancedAppSection}" Style="{StaticResource OffstreamGroupHeaderStyle}" />

                    <DockPanel Style="{StaticResource SwitchRow}">
                        <ui:ToggleSwitch Margin="16,0,0,0"
                                         VerticalAlignment="Center"
                                         AutomationProperties.AutomationId="AdvancedMinimizeToTray"
                                         AutomationProperties.Name="{x:Static res:Strings.AdvancedMinimizeToTray}"
                                         DockPanel.Dock="Right"
                                         IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />

                        <TextBlock Margin="0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource OffstreamFieldLabelStyle}"
                                   Text="{x:Static res:Strings.AdvancedMinimizeToTray}" />
                    </DockPanel>

                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.AdvancedLanguageLabel}" />
                        <ComboBox AutomationProperties.AutomationId="AdvancedLanguage"
                                  AutomationProperties.Name="{x:Static res:Strings.AdvancedLanguageLabel}"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding Languages, Mode=OneTime}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource OffstreamHintStyle}" Text="{x:Static res:Strings.AdvancedLanguageRestart}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Style="{StaticResource OffstreamFieldLabelStyle}" Text="{x:Static res:Strings.AdvancedFfmpegLabel}" />
                        <ui:TextBox x:Name="FfmpegBox"
                                    AutomationProperties.AutomationId="AdvancedFfmpegPath"
                                    AutomationProperties.Name="{x:Static res:Strings.AdvancedFfmpegLabel}"
                                    Text="{Binding FfmpegPath, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}" />
                        <TextBlock Style="{StaticResource OffstreamValidationMessageStyle}" Text="{Binding ElementName=FfmpegBox, Path=(Validation.Errors)/ErrorContent}" />

                        <!--  Which ffmpeg an empty box resolves to, since that is the usual case.  -->
                        <TextBlock Style="{StaticResource OffstreamHintStyle}"
                                   Text="{Binding FfmpegStatus, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTip="{Binding FfmpegStatus, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource OffstreamHintStyle}" Text="{x:Static res:Strings.AdvancedFfmpegHint}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</UserControl>
