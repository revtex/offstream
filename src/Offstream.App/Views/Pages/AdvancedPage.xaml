<Page x:Class="Offstream.App.Views.Pages.AdvancedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:res="clr-namespace:Offstream.App.Resources"
      Title="Advanced">

    <!--
        Tray behaviour, timer, counter, the filename template with its live preview, the
        existing-file policy, detection options and tag options land here in Phase 6 PR 3.
    -->
    <Grid Margin="{StaticResource OffstreamPagePadding}">
        <TextBlock HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Foreground="{StaticResource OffstreamIdleBrush}"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Text="{x:Static res:Strings.PageEmpty}" />
    </Grid>

</Page>
