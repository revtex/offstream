<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Offstream.App.Views.Converters"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <conv:EnumToBooleanConverter x:Key="EnumToBoolean" />
    <conv:UpperCaseConverter x:Key="UpperCase" />

    <!--
        Offstream's design tokens: the values every page reuses so spacing and colour are a
        decision made once, not re-typed per view.

        Deliberately small. WPF-UI already ships a Fluent type ramp (BodyTextBlockStyle,
        SubtitleTextBlockStyle, TitleTextBlockStyle) and a full semantic colour set; duplicating
        either here would mean two sources of truth that drift. What is defined below is only
        what WPF-UI has no opinion about: Offstream's spacing rhythm, its page padding, the
        monospaced face the activity log needs, and the two recording-state colours.

        Merged *after* the WPF-UI dictionaries in App.xaml, so the DynamicResource lookups
        below resolve and follow the active theme.
    -->

    <!-- Spacing rhythm. A 4pt scale: everything in the UI is a multiple of one of these. -->
    <sys:Double x:Key="OffstreamSpaceXs">4</sys:Double>
    <sys:Double x:Key="OffstreamSpaceSm">8</sys:Double>
    <sys:Double x:Key="OffstreamSpaceMd">12</sys:Double>
    <sys:Double x:Key="OffstreamSpaceLg">16</sys:Double>
    <sys:Double x:Key="OffstreamSpaceXl">24</sys:Double>

    <Thickness x:Key="OffstreamPagePadding">24,12,24,24</Thickness>
    <Thickness x:Key="OffstreamStackGap">0,0,0,12</Thickness>

    <!--
        The activity log is read as a stream of timestamped lines, so it needs a fixed pitch.
        Cascadia Mono ships with Windows 11 (Offstream's only target); the rest are fallbacks
        for anyone who has removed it.
    -->
    <FontFamily x:Key="OffstreamMonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>
    <sys:Double x:Key="OffstreamMonoFontSize">12</sys:Double>

    <!--
        Recording state. "Recording" is the one place in the app that earns a saturated colour,
        so it is fixed rather than themed - it must read as the same signal in light and dark.
        Idle and error defer to WPF-UI's semantic brushes, which already handle both themes and
        high contrast.
    -->
    <Color x:Key="OffstreamRecordingColor">#E8483F</Color>
    <SolidColorBrush x:Key="OffstreamRecordingBrush" Color="{StaticResource OffstreamRecordingColor}" />
    <SolidColorBrush x:Key="OffstreamIdleBrush" Color="{DynamicResource TextFillColorSecondary}" />

    <!--
        The level meter's LCD palette.

        Fixed rather than themed, and deliberately so: the meter is drawn as the segment display
        of a field recorder, and a physical LCD looks the same in a dark room as a bright one.
        Following the app theme would make it a rectangle that happens to have bars in it. Holding
        one palette makes it read as an instrument set into the window - which is the point, since
        this is the one control on the page that reports on the audio rather than on Spotify.

        The ghost colour is the load-bearing one. Unlit cells on a real LCD are never invisible;
        keeping them faintly present is what makes a silent meter look like a working meter
        showing nothing, rather than a meter that has stopped.
    -->
    <Color x:Key="OffstreamLcdPanelColor">#C3C9C1</Color>
    <SolidColorBrush x:Key="OffstreamLcdPanelBrush" Color="{StaticResource OffstreamLcdPanelColor}" />
    <SolidColorBrush x:Key="OffstreamLcdGhostBrush" Color="#B0B7AE" />
    <SolidColorBrush x:Key="OffstreamLcdSegmentBrush" Color="#191D19" />
    <SolidColorBrush x:Key="OffstreamLcdInkBrush" Color="#4E554D" />
    <SolidColorBrush x:Key="OffstreamLcdBezelBrush" Color="#2A2E2A" />

    <!--
        The glass itself: a faint vertical gradient with scanlines over it. A flat fill reads as
        a coloured rectangle; the sheen and the line structure are what make the eye accept it as
        a panel with depth behind it. Both are near-invisible individually and only work together,
        which is why they are one brush rather than a tint anyone could tune out.
    -->
    <LinearGradientBrush x:Key="OffstreamLcdGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#CDD3CB" />
        <GradientStop Offset="0.55" Color="#C3C9C1" />
        <GradientStop Offset="1" Color="#B6BDB5" />
    </LinearGradientBrush>

    <!--
        The meter's colour, and the one place the display is not monochrome.

        Read it as pigment, not as light: these are the muted inks a colour e-paper panel can hold,
        chosen to sit on the pale grey ground above rather than to glow off it. A saturated LED
        palette would make the meter the brightest object in the window and turn an instrument face
        into a toy.

        The stops are placed on the decibel scale, not spaced evenly. Position is
        (dB + 50) / 50, so 0.40 is −30 dB, 0.76 is −12 dB and 0.88 is −6 dB — which is why the warm
        half of the spectrum is compressed into the right quarter. That is where the numbers matter:
        the last twelve decibels before clipping are the ones a recordist is watching, and giving
        them their own colours is what makes a glance enough.
    -->
    <LinearGradientBrush x:Key="OffstreamLcdSpectrumBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#3A6EA5" />
        <GradientStop Offset="0.22" Color="#2F8C8C" />
        <GradientStop Offset="0.44" Color="#4E9455" />
        <GradientStop Offset="0.62" Color="#8E9B3C" />
        <GradientStop Offset="0.76" Color="#C2992F" />
        <GradientStop Offset="0.88" Color="#BE7134" />
        <GradientStop Offset="1" Color="#A63A31" />
    </LinearGradientBrush>

    <DrawingBrush x:Key="OffstreamLcdScanlineBrush"
                  TileMode="Tile"
                  Viewport="0,0,2,3"
                  ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#0F000000">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,2,1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!--
        The shell.

        Offstream is a dark app that happens to contain one lit instrument, so the chrome is
        pushed further down than WPF-UI's default surfaces go: the window is nearly black and the
        cards sit just above it. That contrast is what makes the LCD read as the only light source
        on the page rather than as one more panel among several.

        The accent is the app's single interactive colour - the transport button and the active
        tab's underline, and nothing else. Spending it anywhere further would stop it meaning
        "this is the control that does the thing".
    -->
    <SolidColorBrush x:Key="OffstreamWindowBrush" Color="#0C0E11" />
    <SolidColorBrush x:Key="OffstreamSurfaceBrush" Color="#16181C" />
    <SolidColorBrush x:Key="OffstreamSurfaceBorderBrush" Color="#282C33" />
    <SolidColorBrush x:Key="OffstreamRowSeparatorBrush" Color="#22262C" />

    <Color x:Key="OffstreamAccentColor">#2563EB</Color>
    <SolidColorBrush x:Key="OffstreamAccentBrush" Color="{StaticResource OffstreamAccentColor}" />
    <SolidColorBrush x:Key="OffstreamAccentHoverBrush" Color="#3B76F0" />
    <SolidColorBrush x:Key="OffstreamAccentPressedBrush" Color="#1D4FBF" />

    <!--
        Settings row metrics.

        Both settings pages are built from one row shape - label on the left, control on the
        right - and the promise that neither page ever scrolls is a promise about these three
        numbers. They are tokens rather than literals so the fit can be tuned in one place
        instead of across forty rows, which is what makes "make it a little tighter" a one-line
        change rather than a search-and-replace.
    -->
    <sys:Double x:Key="OffstreamFieldWidth">300</sys:Double>
    <sys:Double x:Key="OffstreamRowHeight">34</sys:Double>
    <Thickness x:Key="OffstreamRowGap">0,0,0,6</Thickness>

    <!--
        Field labels are monospaced, which is unusual for a settings form and deliberate here.
        The app's own subject is an instrument face, and carrying its typeface onto the labels is
        what keeps the Settings page looking like part of the same machine rather than a
        preferences dialog that happens to be bundled with it. Values stay in the UI face, so the
        two halves of a row are told apart by more than position.
    -->
    <!--
        Field labels sit above their control, not beside it.

        Beside it is what the mockup showed and what the first build did, and at this window width
        it failed badly: the label went hard left, the control hard right, and six hundred pixels
        of nothing sat between them, so nothing on the page said which value belonged to which
        name. Stacking closes that gap to four pixels at any width and lets the control take the
        whole column, which is where the wasted space went.
    -->
    <Style x:Key="OffstreamFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OffstreamMonoFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        A section band: an accent tick, the name in small caps, and a rule running out to the edge.

        The rule is the working part. Sections used to be a line of text with a separate separator
        above them, which read as two unrelated pieces of furniture; carrying the rule inside the
        header ties the label to the span it introduces and means a section is one element in the
        markup as well as one thing on the page. Upper case rather than a bigger size, because a
        band that is heavier than the settings under it starts competing with them.
    -->
    <Style x:Key="OffstreamGroupHeaderStyle" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,4,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="3"
                                Height="13"
                                VerticalAlignment="Center"
                                Background="{StaticResource OffstreamAccentBrush}"
                                CornerRadius="1.5" />

                        <TextBlock Grid.Column="1"
                                   Margin="9,0,12,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource OffstreamMonoFontFamily}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UpperCase}}" />

                        <Border Grid.Column="2"
                                Height="1"
                                VerticalAlignment="Center"
                                Background="{StaticResource OffstreamRowSeparatorBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A tab in the shell's strip.

        A RadioButton rather than a Button because that is what these are: three options, exactly
        one chosen, and the grouping is what stops two from reading as active at once. Retemplated
        to a flat label over a 2px underline, because the selected state has to survive being the
        only thing on a near-black bar - a filled pill would compete with the transport button
        beside it, which is the one control on the page that should look pressable.
    -->
    <Style x:Key="OffstreamTabStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,0,12,0" />
        <Setter Property="Margin" Value="0,0,20,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentPresenter Grid.Row="0"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />

                        <!--
                            Always present, transparent when unselected: an underline that appears
                            and disappears shifts every label by two pixels as the user moves
                            between tabs.
                        -->
                        <Border x:Name="Underline"
                                Grid.Row="1"
                                Height="2"
                                Margin="0,8,0,0"
                                Background="Transparent"
                                CornerRadius="1" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter TargetName="Underline" Property="Background" Value="{StaticResource OffstreamAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The transport button in the shell header. WPF-UI's Primary appearance follows the system
        accent, which is the user's colour rather than Offstream's; this is the one control that
        has to be the same blue on every machine, since it is what the whole header points at.
    -->
    <Style x:Key="OffstreamTransportButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource OffstreamAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fill"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource OffstreamAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource OffstreamAccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same button in its stop state: the one place the recording red is spent. -->
    <Style x:Key="OffstreamStopButtonStyle"
           BasedOn="{StaticResource OffstreamTransportButtonStyle}"
           TargetType="Button">
        <Setter Property="Background" Value="{StaticResource OffstreamRecordingBrush}" />
    </Style>

    <!-- A card: the surface every page's content sits on. -->
    <Style x:Key="OffstreamCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OffstreamSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OffstreamSurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!--
        The three text roles the settings pages repeat: a group heading, the explanatory line
        under a control, and the message a failed validation puts beneath the field it belongs
        to. Defined once because two pages use them on nearly every row, and because the
        validation message is the one piece of chrome that must never be quietly restyled into
        something that does not read as an error.
    -->
    <Style x:Key="OffstreamSectionHeaderStyle"
           BasedOn="{StaticResource SubtitleTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="Margin" Value="0,12,0,8" />
    </Style>

    <Style x:Key="OffstreamHintStyle"
           BasedOn="{StaticResource CaptionTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OffstreamIdleBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OffstreamValidationMessageStyle"
           BasedOn="{StaticResource CaptionTextBlockStyle}"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />

        <!--
            Collapsed when there is nothing to say, so a valid form has no gaps reserved for
            errors that are not there. Both empty and null: a binding to (Validation.Errors) with
            no errors in it falls back to the property default, and one whose source is null
            does not, so a single trigger would leave the other case occupying a line.
        -->
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
